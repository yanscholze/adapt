        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">AnalyticsService</string>
            <string name="Source">--!nonstrict
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Analytics = {}
function Analytics:Init() self.sink = nil end
function Analytics:SetSink(callback) self.sink = callback end
function Analytics:Once(player, profile, event)
	if profile.milestones[event] then return end
	profile.milestones[event] = true
	if Config.AnalyticsEnabled and self.sink then
		task.spawn(function()
			local ok = pcall(self.sink, player, event, { level = profile.level })
			if not ok then warn("[ADAPT] Analytics sink failed:", event) end
		end)
	end
end
return Analytics
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source">--!nonstrict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Definitions = require(Shared.Adaptations)
local Progression = require(Shared.Progression)
local Synergies = require(Shared.Synergies)
local Characters = {}
local function bodyPart(model, name, size, cf, color, hidden)
	local p = Instance.new("Part"); p.Name = name; p.Size = size; p.CFrame = cf; p.Color = color
	p.Transparency = hidden and 1 or 0; p.CanCollide = false; p.Massless = name ~= "HumanoidRootPart"; p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth; p.Parent = model
	return p
end
local function motor(parent, name, p0, p1, c0, c1)
	local j = Instance.new("Motor6D"); j.Name = name; j.Part0 = p0; j.Part1 = p1; j.C0 = c0 or CFrame.identity; j.C1 = c1 or CFrame.identity; j.Parent = parent; return j
end
local function ornament(folder, root, name, size, offset, color, shape, neon)
	local p = bodyPart(folder, name, size, root.CFrame * offset, color)
	p.Shape = shape or Enum.PartType.Ball; p.Material = neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
	p.CastShadow = not neon
	local w = Instance.new("WeldConstraint"); w.Part0 = root; w.Part1 = p; w.Parent = p
	return p
end
function Characters:Init(players, remotes)
	Players.CharacterAutoLoads = false
	self.players = players; self.remotes = remotes; self.connections = {}; self.generations = {}
end
function Characters:Spawn(player)
	if not player.Parent or not self.players:Get(player) then return end
	if self.connections[player] then self.connections[player]:Disconnect() end
	self.generations[player] = (self.generations[player] or 0) + 1
	local generation = self.generations[player]
	local old = player.Character
	if old then old:Destroy() end
	local model = Instance.new("Model"); model.Name = player.Name
	local spawn = self.spawnPosition and self.spawnPosition(player) or Vector3.new(0, 5, 20)
	local origin = CFrame.new(spawn + Vector3.new((player.UserId % 5 - 2) * 1.5, 0, 0))
	local white = Color3.fromRGB(222, 239, 226)
	local root = bodyPart(model, "HumanoidRootPart", Vector3.new(2, 2, 1), origin, white, true)
	root.RootPriority = 127
	local torso = bodyPart(model, "Torso", Vector3.new(2, 2, 1), origin, white, true)
	torso.CanCollide = true
	local head = bodyPart(model, "Head", Vector3.new(2, 1, 1), origin * CFrame.new(0, 1.5, 0), white, true)
	motor(root, "RootJoint", root, torso)
	motor(torso, "Neck", torso, head, CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0))
	for _, side in { -1, 1 } do
		local label = side == -1 and "Left" or "Right"
		local arm = bodyPart(model, label .. " Arm", Vector3.new(1, 2, 1), origin * CFrame.new(side * 1.5, 0, 0), white, true)
		local leg = bodyPart(model, label .. " Leg", Vector3.new(1, 2, 1), origin * CFrame.new(side * 0.5, -2, 0), white, true)
		motor(torso, label .. " Shoulder", torso, arm, CFrame.new(side * 1, 0.5, 0), CFrame.new(-side * 0.5, 0.5, 0))
		motor(torso, label .. " Hip", torso, leg, CFrame.new(side * 0.5, -1, 0), CFrame.new(0, 1, 0))
	end
	local humanoid = Instance.new("Humanoid"); humanoid.RigType = Enum.HumanoidRigType.R6; humanoid.WalkSpeed = Config.WalkSpeed; humanoid.UseJumpPower = true; humanoid.JumpPower = Config.JumpPower
	humanoid.MaxHealth = 100; humanoid.Health = 100
	humanoid.MaxSlopeAngle = 50; humanoid.DisplayName = player.DisplayName; humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff; humanoid.Parent = model
	local animator = Instance.new("Animator"); animator.Parent = humanoid
	model.PrimaryPart = root; model:SetAttribute("SpawnedAt", os.clock()); model:SetAttribute("AbilityMode", "None"); model:SetAttribute("AbilityStamina", 1)
	model.Parent = workspace; player.Character = model
	root:SetNetworkOwner(player)
	player.CameraMode = Enum.CameraMode.Classic
	self:Apply(player)
	local shield = Instance.new("ForceField"); shield.Visible = false; shield.Parent = model
	task.delay(Config.SpawnProtectionSeconds, function() if shield.Parent then shield:Destroy() end end)
	self.connections[player] = humanoid.Died:Connect(function()
		model:SetAttribute("AbilityMode", "None")
		if self.onDeath then self.onDeath(player) end
		task.delay(3, function() if self.generations[player] == generation then self:Spawn(player) end end)
	end)
	self.players:Send(player)
end
function Characters:Apply(player)
	local r = self.players:Get(player); local model = player.Character
	if not r or not model or not model:FindFirstChild("HumanoidRootPart") then return end
	local old = model:FindFirstChild("Appearance"); if old then old:Destroy() end
	local folder = Instance.new("Folder"); folder.Name = "Appearance"; folder.Parent = model
	local root = model.HumanoidRootPart
	local white = Color3.fromRGB(222, 239, 226)
	ornament(folder, root, "BlankBody", Vector3.new(2.7, 2.8, 2.1), CFrame.new(0, -0.2, 0), white)
	ornament(folder, root, "BlankHead", Vector3.new(2.5, 2, 2.1), CFrame.new(0, 1.25, -0.15), white)
	for _, side in { -1, 1 } do
		ornament(folder, model[side == -1 and "Left Leg" or "Right Leg"], "Foot", Vector3.new(1.1, 0.8, 1.5), CFrame.new(0, -0.65, -0.25), Color3.fromRGB(123, 174, 160))
		ornament(folder, model[side == -1 and "Left Arm" or "Right Arm"], "Paw", Vector3.new(0.75, 1.2, 0.8), CFrame.new(0, -0.5, 0), white)
	end
	local eyeColor = Color3.fromRGB(36, 50, 66); local eyeScale = 1; local bright = false
	for slot, id in r.profile.equipped do
		local def = Definitions[id]; local visual = def.visualData; local color = Color3.fromRGB(table.unpack(visual.color))
		model:SetAttribute("Slot" .. slot, id)
		if visual.kind == "Wings" then
			for _, side in { -1, 1 } do
				ornament(folder, root, "Wing", Vector3.new(3.4, 0.45, 2) * visual.scale, CFrame.new(side * 2.5, 0.65, 0.7) * CFrame.Angles(0, side * -0.3, side * 0.35), color, Enum.PartType.Block)
				ornament(folder, root, "WingTip", Vector3.new(1.4, 0.35, 1.6) * visual.scale, CFrame.new(side * 4.1, 1.35, 1) * CFrame.Angles(0, side * -0.6, side * 0.6), color, Enum.PartType.Block)
			end
		elseif visual.kind == "Claws" then
			for _, side in { -1, 1 } do
				local arm = model[side == -1 and "Left Arm" or "Right Arm"]
				for finger = -1, 1 do ornament(folder, arm, "Claw", Vector3.new(0.18, 0.8, 0.35) * visual.scale, CFrame.new(finger * 0.25, -1.15, -0.38) * CFrame.Angles(-0.4, 0, 0), color, Enum.PartType.Block, true) end
			end
		elseif visual.kind == "Eyes" then eyeColor = color; eyeScale = visual.scale; bright = true
		elseif visual.kind == "Shell" then
			ornament(folder, root, "EmberCarapace", Vector3.new(3.1, 2.6, 1.6), CFrame.new(0, -.2, .9), color)
			for i = -1, 1 do ornament(folder, root, "ShellFacet", Vector3.new(.35, 1.7, .4), CFrame.new(i*.75, 0, 1.65), Color3.fromRGB(255, 214, 125), Enum.PartType.Block, true) end
		elseif visual.kind == "Tail" then
			ornament(folder, root, "TideTail", Vector3.new(.8, .9, 2.4), CFrame.new(0, -1, 1.8)*CFrame.Angles(-.25,0,0), color)
			for _, side in { -1, 1 } do ornament(folder, root, "TailFin", Vector3.new(1.5, .3, 1.1), CFrame.new(side*.65, -.6, 2.8)*CFrame.Angles(0, side*.45,0), color, Enum.PartType.Block) end
		elseif visual.kind == "Legs" then
			for _, side in { -1, 1 } do ornament(folder, model[side == -1 and "Left Leg" or "Right Leg"], "SpringPaw", Vector3.new(1.3, 1, 1.7), CFrame.new(0,-.5,-.2), color) end
		end
	end
	for _, slot in { "Head", "Body", "Arms", "Legs", "Back", "Tail" } do if not r.profile.equipped[slot] then model:SetAttribute("Slot" .. slot, nil) end end
	for _, side in { -1, 1 } do ornament(folder, root, "Eye", Vector3.new(0.36, 0.5, 0.28) * eyeScale, CFrame.new(side * 0.55, 1.4, -1.15), eyeColor, Enum.PartType.Ball, bright) end
	local active = Progression.synergies(r.profile.equipped, Definitions, Synergies)
	if #active &gt; 0 then
		local light = Instance.new("PointLight"); light.Color = Color3.fromRGB(190, 170, 255); light.Brightness = 0.7; light.Range = 7; light.Parent = folder.BlankBody
	end
	if r.profile.journey and r.profile.journey.complete then
		for i = 1, 5 do
			local a = i*math.pi*2/5
			ornament(folder, root, "WorldkeeperCrown", Vector3.new(.25, .65, .25), CFrame.new(math.cos(a)*.7, 2.5, math.sin(a)*.7-.15), Color3.fromRGB(255, 222, 130), Enum.PartType.Block, true)
		end
	end
end
function Characters:Remove(player)
	self.generations[player] = nil
	if self.connections[player] then self.connections[player]:Disconnect(); self.connections[player] = nil end
	if player.Character then player.Character:Destroy() end
end
return Characters
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">DebugService</string>
            <string name="Source">--!nonstrict
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Definitions = require(Shared.Adaptations)
local Areas = require(Shared.Areas)
local Debug = {}
function Debug:Allowed(player)
	return RunService:IsStudio() or table.find(Config.AdminUserIds, player.UserId) ~= nil
end
function Debug:Init(players, characters, ability, remotes)
	self.players = players; self.characters = characters; self.ability = ability; self.remotes = remotes
end
function Debug:Execute(player, command, argument: any)
	if not self:Allowed(player) or type(command) ~= "string" then return end
	local r = self.players:Get(player); if not r then return end
	if command == "energy" then
		if type(argument) == "number" and argument == argument and math.abs(argument) &lt; math.huge then self.players:Energy(player, math.clamp(argument, 1, 500), "Debug") end
	elseif command == "grant" and type(argument) == "string" and Definitions[argument] then
		local definition = Definitions[argument]; r.profile.equipped[definition.slot] = argument; r.profile.discovered[argument] = true
		self.ability:Stop(player); self.characters:Apply(player); self.players:Send(player)
	elseif command == "reset" then
		r.profile.equipped = {}; r.pending = nil; r.profile.energy = 0; self.ability:Stop(player); self.characters:Apply(player); self.players:Send(player)
	elseif command == "teleport" and type(argument) == "string" and Areas[argument] then self.ability:Teleport(player, Vector3.new(table.unpack(Areas[argument].spawn)))
	elseif command == "state" then
		print("[ADAPT DEBUG]", player.UserId, HttpService:JSONEncode(r.profile)); self.remotes.Feedback:FireClient(player, "Info", "Estado impresso no Output do servidor.")
	end
end
return Debug
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">EssenceService</string>
            <string name="Source">--!nonstrict
local CollectionService = game:GetService("CollectionService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Definitions = require(Shared.Essences)
local Adaptations = require(Shared.Adaptations)
local Progression = require(Shared.Progression)
local Essence = {}
function Essence:Init(world, players, remotes, canInteract)
	self.players = players; self.remotes = remotes; self.canInteract = canInteract; self.nodes = {}
	local old = world.model:FindFirstChild("Essence"); if old then old:Destroy() end
	local folder = Instance.new("Folder"); folder.Name = "Essence"; folder.Parent = world.model
	for _, spawn in world.essenceSpawns do
		local definition = Definitions[spawn.kind]
		local orb = Instance.new("Part"); orb.Name = spawn.id; orb.Shape = Enum.PartType.Ball; orb.Size = Vector3.one * definition.visual.size
		orb.CFrame = CFrame.new(spawn.position); orb.Anchored = true; orb.CanCollide = false; orb.CanTouch = false; orb.CanQuery = false
		orb.Material = Enum.Material.Neon; orb.Color = Color3.fromRGB(table.unpack(definition.visual.color)); orb:SetAttribute("EssenceKind", spawn.kind); orb:SetAttribute("Available", true)
		orb.Transparency = definition.spawn.requiredAbility and 1 or 0; orb.Parent = folder
		if definition.spawn.requiredAbility then CollectionService:AddTag(orb, "NightVisionRevealable") else
			local light = Instance.new("PointLight"); light.Color = orb.Color; light.Brightness = 0.6; light.Range = 7; light.Parent = orb
		end
		table.insert(self.nodes, { part = orb, definition = definition, readyAt = 0 })
	end
end
function Essence:Step(now)
	for _, node in self.nodes do
		local orb = node.part
		if node.readyAt &gt; 0 and now &gt;= node.readyAt then
			node.readyAt = 0; orb:SetAttribute("Available", true)
			orb.Transparency = node.definition.spawn.requiredAbility and 1 or 0
			local light = orb:FindFirstChildOfClass("PointLight"); if light then light.Enabled = true end
		end
		if node.readyAt == 0 then
			for player, r in self.players.records do
				if r.pending then continue end
				local character = player.Character; local root = character and character:FindFirstChild("HumanoidRootPart"); local h = character and character:FindFirstChildOfClass("Humanoid")
				if not root or not h or h.Health &lt;= 0 or not self.canInteract(player) then continue end
				if (root.CFrame.Position - orb.CFrame.Position).Magnitude &gt; Config.CollectRadius then continue end
				local needed = node.definition.spawn.requiredAbility
				if needed and not Progression.hasAbility(r.profile.equipped, Adaptations, needed) then continue end
				-- Commit availability before awarding; one shared orb has exactly one winner.
				node.readyAt = now + node.definition.spawn.respawnSeconds; orb:SetAttribute("Available", false); orb.Transparency = 1
				local light = orb:FindFirstChildOfClass("PointLight"); if light then light.Enabled = false end
				self.players:Energy(player, node.definition.energyValue, "Essence")
				self.remotes.Feedback:FireClient(player, "Essence", node.definition.energyValue, orb.CFrame.Position)
				break
			end
		end
	end
end
return Essence
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">FinaleService</string>
            <string name="Source">--!nonstrict
local Shared = game:GetService("ReplicatedStorage").Shared
local Journey = require(Shared.Journey)
local Definitions = require(Shared.Adaptations)
local Progression = require(Shared.Progression)
local Finale = {}
local function part(parent, name, size, pos, color, shape)
	local p = Instance.new("Part"); p.Name = name; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
	p.Size = size; p.CFrame = CFrame.new(pos); p.Color = color; p.Material = Enum.Material.Neon; p.Shape = shape or Enum.PartType.Ball; p.Parent = parent; return p
end
function Finale:Init(world, players, journey, remotes, canInteract)
	self.players = players; self.journey = journey; self.remotes = remotes; self.canInteract = canInteract
	self.center = Vector3.new(table.unpack(Journey.finale.position)); self.lastAttack = {}; self.contributors = {}; self.hp = Journey.finale.maxHealth; self.active = false; self.sequence = 0; self.nextAttack = 0
	local old = world.model:FindFirstChild("ZenithGuardian"); if old then old:Destroy() end
	self.model = Instance.new("Model"); self.model.Name = "ZenithGuardian"; self.model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic; self.model.Parent = world.model
	self.core = part(self.model, "Heart", Vector3.new(6, 8, 6), self.center, Color3.fromRGB(202, 182, 255))
	for i = 1, 6 do
		local a = i * math.pi/3
		local blade = part(self.model, "CrownPetal", Vector3.new(2, 8, 3), self.center + Vector3.new(math.cos(a)*5, 4, math.sin(a)*5), Color3.fromRGB(125, 147, 191), Enum.PartType.Block)
		blade.CFrame *= CFrame.Angles(0, -a, .3)
	end
	self.prompt = Instance.new("ProximityPrompt"); self.prompt.ActionText = "Despertar"; self.prompt.ObjectText = "Guardião do Zênite • 8 sementes"; self.prompt.KeyboardKeyCode = Enum.KeyCode.R; self.prompt.GamepadKeyCode = Enum.KeyCode.ButtonB; self.prompt.HoldDuration = 1; self.prompt.MaxActivationDistance = 18; self.prompt.RequiresLineOfSight = false; self.prompt.Parent = self.core
	self.prompt.Triggered:Connect(function(player) self:Start(player) end)
	local gui = Instance.new("BillboardGui"); gui.Size = UDim2.fromOffset(310, 70); gui.StudsOffset = Vector3.new(0, 11, 0); gui.MaxDistance = 100; gui.Parent = self.core
	self.label = Instance.new("TextLabel"); self.label.Size = UDim2.fromScale(1, 1); self.label.TextWrapped = true; self.label.FontFace = Font.fromEnum(Enum.Font.GothamBold); self.label.TextSize = 17; self.label.BackgroundColor3 = Color3.fromRGB(24, 30, 50); self.label.TextColor3 = Color3.fromRGB(237, 229, 255); self.label.Parent = gui
	self.warning = Instance.new("Folder"); self.warning.Name = "Telegraphs"; self.warning.Parent = self.model
	self:Update("OITO SEMENTES • UM MUNDO")
end
function Finale:Eligible(player, range)
	local r = self.players:Get(player); local char = player.Character; local root = char and char:FindFirstChild("HumanoidRootPart"); local h = char and char:FindFirstChildOfClass("Humanoid")
	if not r or Journey.count(r.profile.journey.seals) &lt; 8 or not root or not h or h.Health &lt;= 0 or not self.canInteract(player) then return nil end
	if (root.CFrame.Position - self.center).Magnitude &gt; range then return nil end
	return h, root
end
function Finale:Update(message)
	self.model:SetAttribute("Health", self.hp); self.model:SetAttribute("MaxHealth", Journey.finale.maxHealth); self.model:SetAttribute("Active", self.active)
	self.label.Text = string.format("GUARDIÃO DO ZÊNITE • %d / %d\n%s", self.hp, Journey.finale.maxHealth, message or "")
end
function Finale:Start(player)
	if self.active or self.respawnAt or not self:Eligible(player, 20) then
		if not self.active then self.remotes.Feedback:FireClient(player, "Info", "Restaure as oito sementes para despertar o guardião.") end
		return false
	end
	self.active = true; self.hp = Journey.finale.maxHealth; self.contributors = {}; self.sequence = 0; self.nextAttack = os.clock() + 2; self.lastTarget = os.clock(); self.prompt.Enabled = false
	self:Update("Observe a luz no chão. Ataque entre os pulsos."); return true
end
function Finale:Attack(player)
	if not self.active or self.hp &lt;= 0 or not self:Eligible(player, 16) then return false end
	if self.players:Get(player).pending then return false end
	local now = os.clock(); if now - (self.lastAttack[player] or -10) &lt; .55 then return false end
	local char = player.Character; local root = char.HumanoidRootPart
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = { char, self.model }
	if workspace:Raycast(root.CFrame.Position, self.center - root.CFrame.Position, params) then return false end
	self.lastAttack[player] = now; self.contributors[player] = true; self.hp = math.max(0, self.hp - 16)
	self.remotes.Feedback:FireClient(player, "Hit", 16); self:Update(self.pattern and self.pattern.message or "Encontre espaço entre os pulsos")
	if self.hp == 0 then
		self.active = false; self.pattern = nil; self.warning:ClearAllChildren(); self.respawnAt = now + 45
		self:Update("O ARQUIPÉLAGO DESPERTOU")
		for contributor in self.contributors do if self:Eligible(contributor, 65) then self.journey:Complete(contributor) end end
		self.contributors = {}
	end
	return true
end
function Finale:Warn(now)
	self.sequence += 1; local kind = (self.sequence - 1) % 3 + 1; local phase = self.hp &lt;= Journey.finale.maxHealth/2
	local pattern = { kind = kind, strikesAt = now + (phase and 1.25 or 1.65), targets = {}, message = "" }
	local function disk(pos, radius)
		local p = part(self.warning, "Danger", Vector3.new(.18, radius*2, radius*2), Vector3.new(pos.X, self.center.Y - 3.7, pos.Z), Color3.fromRGB(255, 123, 137), Enum.PartType.Cylinder)
		p.CFrame *= CFrame.Angles(0, 0, math.pi/2); p.Transparency = .4
	end
	if kind == 1 then disk(self.center, 18); pattern.message = "PULSO • afaste-se do centro"
	elseif kind == 2 then
		pattern.message = "ANEL • entre no centro iluminado"
		for i = 1, 24 do local a = i*math.pi/12; disk(self.center + Vector3.new(math.cos(a)*27, 0, math.sin(a)*27), 8) end
	else
		pattern.message = "ECOS • saia das marcas no chão"
		for player in self.players.records do local _, root = self:Eligible(player, 40); if root then table.insert(pattern.targets, root.CFrame.Position); disk(root.CFrame.Position, 7) end end
	end
	self.pattern = pattern; self.nextAttack = now + (phase and 3.3 or 4.1); self:Update(pattern.message)
end
function Finale:Step(now)
	if self.respawnAt then
		if now &gt;= self.respawnAt then self.respawnAt = nil; self.hp = Journey.finale.maxHealth; self.prompt.Enabled = true; self:Update("OITO SEMENTES • UM MUNDO") end
		return
	end
	if not self.active then return end
	local target = false
	for player in self.players.records do if self:Eligible(player, 60) then target = true; break end end
	if target then self.lastTarget = now elseif now - self.lastTarget &gt; 10 then
		self.active = false; self.hp = Journey.finale.maxHealth; self.pattern = nil; self.contributors = {}; self.warning:ClearAllChildren(); self.prompt.Enabled = true; self:Update("Aguardando seu retorno"); return
	end
	local p = self.pattern
	if p and now &gt;= p.strikesAt then
		for player, r in self.players.records do
			local h, root = self:Eligible(player, 43); if not h or r.pending or player.Character:FindFirstChildOfClass("ForceField") then continue end
			local delta = root.CFrame.Position - self.center; local d = Vector3.new(delta.X, 0, delta.Z).Magnitude
			local hit = p.kind == 1 and d &lt;= 18 or p.kind == 2 and d &gt;= 19 and d &lt;= 35
			if p.kind == 3 then for _, pos in p.targets do if Vector3.new(pos.X-root.CFrame.Position.X, 0, pos.Z-root.CFrame.Position.Z).Magnitude &lt;= 7 then hit = true end end end
			if hit and math.abs(root.CFrame.Position.Y - self.center.Y) &lt; 8 then
				local damage = Progression.hasAbility(r.profile.equipped, Definitions, "HeatResistance") and 18 or 24
				h:TakeDamage(damage); self.remotes.Feedback:FireClient(player, "Hurt", damage)
			end
		end
		self.pattern = nil; self.warning:ClearAllChildren(); self:Update("Agora! Aproxime-se para atacar.")
	elseif not p and now &gt;= self.nextAttack then self:Warn(now) end
end
function Finale:Remove(player) self.lastAttack[player] = nil; self.contributors[player] = nil end
return Finale
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">GuardianService</string>
            <string name="Source">--!nonstrict
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)
local Definitions = require(Shared.Adaptations)
local G = Config.Guardian
local Guardian = {}
function Guardian:Init(world, players, remotes, analytics, canInteract)
	self.world = world; self.players = players; self.remotes = remotes; self.analytics = analytics; self.canInteract = canInteract
	local old = world.model:FindFirstChild("Guardian"); if old then old:Destroy() end
	self.damageByPlayer = {}; self.lastAttack = {}; self.nextAttack = 0; self:Spawn()
end
function Guardian:Spawn()
	if self.model then self.model:Destroy() end
	self.model = Instance.new("Model"); self.model.Name = "Guardian"; self.model.Parent = self.world.model
	self.hp = G.MaxHealth; self.damageByPlayer = {}; self.pendingStrike = nil; self.respawnAt = nil
	local core = Instance.new("Part"); core.Name = "Core"; core.Size = Vector3.new(7, 7, 7); core.Shape = Enum.PartType.Ball
	core.CFrame = CFrame.new(self.world.guardianPosition); core.Color = Color3.fromRGB(150, 120, 179); core.Material = Enum.Material.Slate; core.Anchored = true; core.Parent = self.model
	self.core = core; self.model.PrimaryPart = core
	for _, side in { -1, 1 } do
		local eye = Instance.new("Part"); eye.Name = "Eye"; eye.Size = Vector3.new(0.8, 1.3, 0.3); eye.CFrame = CFrame.new(core.CFrame.Position + Vector3.new(side * 1.2, 1, -3.3)); eye.Anchored = true; eye.CanCollide = false; eye.Color = Color3.fromRGB(255, 198, 110); eye.Material = Enum.Material.Neon; eye.Parent = self.model
	end
	local gui = Instance.new("BillboardGui"); gui.Size = UDim2.fromOffset(230, 58); gui.StudsOffset = Vector3.new(0, 5, 0); gui.MaxDistance = 100; gui.Parent = core
	self.label = Instance.new("TextLabel"); self.label.Size = UDim2.fromScale(1, 1); self.label.BackgroundColor3 = Color3.fromRGB(35, 32, 54); self.label.TextColor3 = Color3.new(1, 1, 1); self.label.FontFace = Font.fromEnum(Enum.Font.GothamBold); self.label.TextSize = 17; self.label.Parent = gui
	local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 12); corner.Parent = self.label
	local ring = Instance.new("Part"); ring.Name = "AttackWarning"; ring.Shape = Enum.PartType.Cylinder; ring.Size = Vector3.new(0.15, G.AttackRange * 2, G.AttackRange * 2)
	ring.CFrame = CFrame.new(core.CFrame.Position.X, 0.5, core.CFrame.Position.Z) * CFrame.Angles(0, 0, math.pi / 2); ring.Color = Color3.fromRGB(255, 86, 116); ring.Material = Enum.Material.Neon; ring.Anchored = true; ring.CanCollide = false; ring.CanQuery = false; ring.Transparency = 1; ring.Parent = self.model; self.ring = ring
	self:Update()
end
function Guardian:Update()
	self.model:SetAttribute("Health", self.hp); self.model:SetAttribute("MaxHealth", G.MaxHealth)
	self.label.Text = "GUARDIAN  •  " .. self.hp .. " / " .. G.MaxHealth
end
function Guardian:Eligible(player, range)
	local char = player.Character; local root = char and char:FindFirstChild("HumanoidRootPart"); local h = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not h or h.Health &lt;= 0 or not self.canInteract(player) then return nil end
	if (root.CFrame.Position - self.core.CFrame.Position).Magnitude &gt; range then return nil end
	return h
end
function Guardian:Attack(player)
	if self.hp &lt;= 0 or not self.players:Get(player) then return end
	if self.players:Get(player).pending then return end
	local now = os.clock()
	if now - (self.lastAttack[player] or 0) &lt; G.PlayerCooldown or not self:Eligible(player, G.PlayerRange) then return end
	local root = player.Character.HumanoidRootPart
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = { player.Character }
	local hit = workspace:Raycast(root.CFrame.Position, self.core.CFrame.Position - root.CFrame.Position, params)
	if hit and not hit.Instance:IsDescendantOf(self.model) then return end
	self.lastAttack[player] = now
	self.hp = math.max(0, self.hp - G.PlayerDamage); self.damageByPlayer[player] = (self.damageByPlayer[player] or 0) + G.PlayerDamage
	self.remotes.Feedback:FireClient(player, "Hit", G.PlayerDamage); self:Update()
	if self.hp &gt; 0 then return end
	self.pendingStrike = nil; self.ring.Transparency = 1; self.core.Transparency = 0.7; self.respawnAt = now + G.RespawnSeconds
	self.label.Text = "GUARDIAN • regenerando…"
	-- Every nearby contributor receives one server-issued reward, once per life.
	for contributor in self.damageByPlayer do
		local r = self.players:Get(contributor)
		if r and self:Eligible(contributor, G.ArenaRange + 10) then
			self.analytics:Once(contributor, r.profile, "FIRST_GUARDIAN_DEFEATED")
			if self.onDefeated then self.onDefeated(contributor) end
			self.players:Energy(contributor, G.Reward, "Guardian"); self.remotes.Feedback:FireClient(contributor, "Guardian", G.Reward)
		end
	end
	self.damageByPlayer = {}
end
function Guardian:Step(now)
	if self.hp &lt;= 0 then if self.respawnAt and now &gt;= self.respawnAt then self:Spawn() end; return end
	local hasTarget = false
	for player, r in self.players.records do
		if self:Eligible(player, G.ArenaRange) then self.analytics:Once(player, r.profile, "FIRST_GUARDIAN"); hasTarget = true end
	end
	if self.pendingStrike and now &gt;= self.pendingStrike then
		self.pendingStrike = nil; self.ring.Transparency = 1
		for player in self.players.records do
			local h = self:Eligible(player, G.AttackRange)
			if h and not self.players:Get(player).pending and not player.Character:FindFirstChildOfClass("ForceField") then
				local r = self.players:Get(player)
				local damage = Progression.hasAbility(r.profile.equipped, Definitions, "HeatResistance") and G.Damage*.75 or G.Damage
				h:TakeDamage(damage); self.remotes.Feedback:FireClient(player, "Hurt", damage)
			end
		end
	elseif not self.pendingStrike and hasTarget and now &gt;= self.nextAttack then
		self.pendingStrike = now + G.Windup; self.nextAttack = now + G.AttackCooldown; self.ring.Transparency = 0.45
	end
end
function Guardian:Remove(player) self.lastAttack[player] = nil; self.damageByPlayer[player] = nil end
return Guardian
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">JourneyService</string>
            <string name="Source">--!nonstrict
local Shared = game:GetService("ReplicatedStorage").Shared
local Journey = require(Shared.Journey)
local Locations = require(Shared.JourneyLocations)
local Definitions = require(Shared.Adaptations)
local Progression = require(Shared.Progression)
local Sanctuaries = require(script.Parent.Parent.World.Sanctuaries)
local Service = {}
local function v(p) return Vector3.new(table.unpack(p)) end
function Service:Init(world, players, ability, characters, remotes)
	self.world = world; self.players = players; self.ability = ability; self.characters = characters; self.remotes = remotes
	self.lastRescue = {}; self.lastTravel = {}; self.lastDamage = {}; self.oxygen = {}; self.connections = {}; self.lastStep = nil
	local folder = Sanctuaries:Build(world)
	for _, object in folder:GetDescendants() do
		if object:IsA("ProximityPrompt") then
			local part = object.Parent
			local action = part:GetAttribute("Camp") and "camp" or part:GetAttribute("Shrine") and "seal" or "rune"
			local id = part:GetAttribute("Camp") or part:GetAttribute("Shrine") or part:GetAttribute("Memory")
			if id then table.insert(self.connections, object.Triggered:Connect(function(player) self:Interact(player, action, id) end)) end
		end
	end
	players.journey = self
	characters.spawnPosition = function(player)
		local r = players:Get(player)
		return r and v(Locations.camps[r.profile.journey.checkpoint] or Locations.camps.Wilds) or Vector3.new(0, 5, 20)
	end
	characters.onDeath = function(player)
		local r = players:Get(player); if not r then return end
		r.profile.journey.deaths += 1; self.oxygen[player] = nil
		remotes.Feedback:FireClient(player, "Info", "Você retorna ao último refúgio em 3 s. Suas descobertas estão preservadas.")
	end
end
function Service:Alive(player)
	local char = player.Character; local root = char and char:FindFirstChild("HumanoidRootPart"); local h = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not h or h.Health &lt;= 0 or not self.players:Get(player) then return nil end
	return root, h
end
function Service:Near(player, point, radius)
	local root = self:Alive(player)
	return root ~= nil and self.ability:CanInteract(player) and (root.CFrame.Position - v(point)).Magnitude &lt;= radius
end
function Service:Info(player, message) self.remotes.Feedback:FireClient(player, "Info", message) end
function Service:Grant(player, id)
	local r = self.players:Get(player); local d = Definitions[id]
	if not r or not d then return end
	r.profile.milestones["UNLOCK_" .. id] = true
	if r.profile.discovered[id] then return end
	r.profile.discovered[id] = true; r.profile.equipped[d.slot] = id
	if self.players.onBuildChanged then self.players.onBuildChanged(player) end
	self.remotes.Feedback:FireClient(player, "Evolution", d.displayName)
end
function Service:GuardianDefeated(player)
	local r = self.players:Get(player); if not r or r.profile.journey.guardian then return end
	r.profile.journey.guardian = true
	for _, id in { "Wings", "GripClaws", "NightEyes" } do self:Grant(player, id) end
	self:Info(player, "Os três caminhos se abriram. Encontre as memórias no penhasco, na caverna e na ilha inicial.")
	self.players:Send(player)
end
function Service:Interact(player, action, id)
	local r = self.players:Get(player); if not r or type(action) ~= "string" or type(id) ~= "string" then return false end
	local p = r.profile; local j = p.journey
	if action == "intro" then j.started = true; self.players:Send(player); return true end
	local point = action == "rune" and Locations.runes[id] and Locations.runes[id].position or Locations.camps[id]
	if not point or not self:Near(player, point, action == "rune" and 13 or 19) then return false end
	if action == "camp" then
		local first = not j.camps[id]; local changed = j.checkpoint ~= id or first
		j.camps[id] = true; j.checkpoint = id
		local _, h = self:Alive(player); h.Health = h.MaxHealth; self.oxygen[player] = 20
		if first then self:Info(player, "Refúgio descoberto. Você pode voltar pelo mapa e trocar suas adaptações aqui.")
		elseif changed then self:Info(player, "Novo ponto de retorno definido.") else self:Info(player, "Vida restaurada. Abra o diário para trocar seu corpo ou viajar.") end
		self.players:Send(player); return true
	end
	if not j.guardian then self:Info(player, "Primeiro, desperte seu corpo e vença o guardião de Verdant."); return false end
	local area = action == "rune" and Journey.runeRegion(id) or id
	local region = Journey.regions[area]; if not region then return false end
	if region.ability and not Progression.hasAbility(p.equipped, Definitions, region.ability) then
		self:Info(player, area == "Tideglass" and "Equipe a Cauda das Marés, recebida em Oldgrowth." or area == "EmberAtoll" and "Equipe a Carapaça de Brasa, recebida em Sunscar." or area == "Hollow" and "Equipe os olhos de visão noturna no refúgio." or "Equipe suas asas no refúgio."); return false
	end
	if action == "rune" then
		if j.runes[id] then self:Info(player, "Esta memória já faz parte do seu diário."); return false end
		j.runes[id] = true; self.players:Energy(player, 12, "Memory")
		self.remotes.Feedback:FireClient(player, "Memory", region.name); self.players:Send(player); return true
	elseif action == "seal" then
		if j.seals[id] then self:Info(player, "Esta semente já foi restaurada."); return false end
		if not Journey.ready(j, id) then self:Info(player, "Encontre as três memórias deste bioma. O diário mostra a direção."); return false end
		j.seals[id] = true; j.camps[id] = true; j.checkpoint = id
		if region.reward then self:Grant(player, region.reward) end
		if Journey.count(j.seals) &gt;= 7 then self:Grant(player, "SkyWings") end
		self.players:Energy(player, 40, "Sanctuary"); self.remotes.Feedback:FireClient(player, "Chapter", region.name, region.lore); self.players:Send(player); return true
	end
	return false
end
function Service:AtCamp(player)
	for area, point in Locations.camps do if self:Near(player, point, 24) then return area end end
	return nil
end
function Service:Equip(player, id)
	local r = self.players:Get(player)
	if not r or type(id) ~= "string" or not Definitions[id] or not r.profile.discovered[id] or r.pending then return false end
	if not self:AtCamp(player) then self:Info(player, "Aproxime-se de um refúgio para mudar de corpo."); return false end
	r.profile.equipped[Definitions[id].slot] = id
	if self.players.onBuildChanged then self.players.onBuildChanged(player) end
	self.players:Send(player); return true
end
function Service:Travel(player, id)
	local r = self.players:Get(player); local root = self:Alive(player)
	if not r or not root or type(id) ~= "string" or not Locations.camps[id] then return false end
	local now = os.clock()
	if now - (self.lastTravel[player] or -100) &lt; 3 then return false end
	if not r.profile.journey.camps[id] or not self:AtCamp(player) then self:Info(player, "Viaje a partir de um refúgio para outro já descoberto."); return false end
	self.lastTravel[player] = now; r.profile.journey.checkpoint = id
	self.ability:Teleport(player, v(Locations.camps[id])); self.players:Send(player); return true
end
function Service:Rescue(player)
	local r = self.players:Get(player); if not r or not self:Alive(player) then return false end
	local now = os.clock()
	if now - (self.lastRescue[player] or -100) &lt; 30 then self:Info(player, "O resgate recarrega em até 30 segundos."); return false end
	self.lastRescue[player] = now
	self.ability:Teleport(player, v(Locations.camps[r.profile.journey.checkpoint] or Locations.camps.Wilds))
	self:Info(player, "Você voltou ao seu refúgio. Nenhum progresso foi perdido."); return true
end
function Service:Snapshot(player)
	local r = self.players:Get(player); if not r then return nil end
	local objective = Journey.objective(r.profile)
	if objective.target then objective.position = Locations.runes[objective.target].position
	elseif objective.region then objective.position = Locations.camps[objective.region] end
	return { objective = objective, seals = Journey.count(r.profile.journey.seals), total = 8 }
end
function Service:Complete(player)
	local r = self.players:Get(player)
	if not r or r.profile.journey.complete or Journey.count(r.profile.journey.seals) &lt; 8 then return false end
	r.profile.journey.complete = true
	self.players:Energy(player, Journey.finale.reward, "Finale")
	if self.players.onBuildChanged then self.players.onBuildChanged(player) end
	self.remotes.Feedback:FireClient(player, "Complete", "GUARDIÃO DO ARQUIPÉLAGO"); self.players:Send(player); return true
end
function Service:Step(now)
	local dt = math.min(1, math.max(0, now - (self.lastStep or now))); self.lastStep = now
	for player, r in self.players.records do
		local root, h = self:Alive(player); if not root then continue end
		local char = player.Character; local pos = root.CFrame.Position
		local aquatic = Progression.hasAbility(r.profile.equipped, Definitions, "Aquatic") ~= nil
		local heat = Progression.hasAbility(r.profile.equipped, Definitions, "HeatResistance") ~= nil
		local leap = Progression.hasAbility(r.profile.equipped, Definitions, "Leap") ~= nil
		local swimming = h:GetState() == Enum.HumanoidStateType.Swimming
		if not h.PlatformStand then h.WalkSpeed = swimming and aquatic and 28 or leap and 24 or 20 end
		h.JumpPower = leap and 60 or 42
		local submerged = swimming and pos.Y &lt; -24
		self.oxygen[player] = submerged and not aquatic and math.max(0, (self.oxygen[player] or 20) - (r.pending and 0 or dt)) or 20
		char:SetAttribute("Oxygen", self.oxygen[player] / 20); char:SetAttribute("Aquatic", aquatic)
		local hot = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(1100, 0, -1020)).Magnitude &lt; 150 and pos.Y &gt; 290
		char:SetAttribute("HeatDanger", hot and not heat)
		if not r.pending and (self.oxygen[player] == 0 or hot and not heat) and now - (self.lastDamage[player] or 0) &gt;= 1 then
			self.lastDamage[player] = now; h:TakeDamage(8)
		end
		-- Gentle recovery outside both arenas; refuges restore immediately on interaction.
		local nearGuardian = (pos - self.world.guardianPosition).Magnitude &lt; 45
		local nearFinale = (pos - v(Journey.finale.position)).Magnitude &lt; 52
		if not nearGuardian and not nearFinale and not hot and not submerged then h.Health = math.min(h.MaxHealth, h.Health + dt * 3) end
		if pos.Y &lt; -220 or math.abs(pos.X) &gt; 2000 or math.abs(pos.Z) &gt; 2000 then self:Rescue(player) end
	end
end
function Service:Remove(player)
	for _, t in { self.lastRescue, self.lastTravel, self.lastDamage, self.oxygen } do t[player] = nil end
end
return Service
</string>
