    <Item class="StarterPlayerScripts" referent="38">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="39">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source">--!nonstrict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CAS = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local folder = ReplicatedStorage:WaitForChild("Remotes")
local remotes = {}
for _, name in Config.Remotes do remotes[name] = folder:WaitForChild(name) end
local Controllers = script.Controllers
local Hud = require(Controllers.HudController)
local Ability = require(Controllers.AbilityController)
local Night = require(Controllers.NightVisionController)
local Feedback = require(Controllers.FeedbackController)
local Animation = require(Controllers.AnimationController)
local Environment = require(Controllers.EnvironmentController)
local Navigation = require(Controllers.NavigationController)
local JourneyVisual = require(Controllers.JourneyVisualController)
local hud = Hud.new(remotes)
local ability = Ability.new(remotes, function() return hud:IsModal() end)
local night = Night.new()
local feedback = Feedback.new(hud)
local animation = Animation.new()
local environment = Environment.new()
local navigation = Navigation.new(hud)
local journeyVisual = JourneyVisual.new()
local receivedState = false
remotes.State.OnClientEvent:Connect(function(state)
	receivedState = true; hud:Update(state); ability:Update(state); night:Update(state); feedback:Update(state); animation:Update(state); environment:Update(state)
	journeyVisual:Update(state)
end)
remotes.Feedback.OnClientEvent:Connect(function(kind, value, extra) feedback:Event(kind, value, extra); if kind == "Area" then environment:Area(value) end end)
CAS:BindAction("AdaptCodex", function(_, input)
	if input == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() and not hud.choice.scrim.Visible then hud.codex.scrim.Visible = false; hud.journal:Toggle() end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.C, Enum.KeyCode.ButtonSelect)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	local index = ({ [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3 })[input.KeyCode]
	if index and hud.choice.scrim.Visible then hud.choice:Pick(index) end
	if input.KeyCode == Enum.KeyCode.M and not hud.choice.scrim.Visible then hud.codex.scrim.Visible = false; hud.journal:Toggle("Mapa") end
	if input.KeyCode == Enum.KeyCode.Escape then hud.codex.scrim.Visible = false; hud.debug.Visible = false; hud.journal:Close() end
end)

local viewportConnection
local function cameraChanged()
	if viewportConnection then viewportConnection:Disconnect() end
	local camera = workspace.CurrentCamera; if not camera then return end
	local function resize() hud:Resize(camera.ViewportSize); ability:Resize(camera.ViewportSize) end
	viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize); resize()
	local char = Players.LocalPlayer.Character; local h = char and char:FindFirstChildOfClass("Humanoid")
	if h then camera.CameraSubject = h end
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(cameraChanged); cameraChanged()
Players.LocalPlayer.CharacterAdded:Connect(function(char)
	local h = char:WaitForChild("Humanoid", 10)
	if h and workspace.CurrentCamera then workspace.CurrentCamera.CameraSubject = h end
end)

local accumulated = 0
RunService.Heartbeat:Connect(function(dt)
	environment:Step(dt)
	accumulated += dt; if accumulated &lt; 0.2 then return end; accumulated = 0
	local char = Players.LocalPlayer.Character; local h = char and char:FindFirstChildOfClass("Humanoid")
	if h then hud:Vitals(h.Health, char:GetAttribute("AbilityStamina") or 1, char:GetAttribute("AbilityMode") or "None") end
	feedback:Step()
	navigation:Step()
end)
task.spawn(function()
	for _ = 1, 15 do
		if receivedState then break end
		remotes.RequestState:FireServer(); task.wait(1)
	end
	if not receivedState then hud:Message("Não foi possível carregar o estado. Confira o Output do servidor e reinicie o teste.") end
end)
</string>
        </Properties>
        <Item class="Folder" referent="40">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">AbilityController</string>
              <string name="Source">--!nonstrict
local Players = game:GetService("Players")
local CAS = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Ability = {}
function Ability.new(remotes, isModal)
	local self = setmetatable({ remotes = remotes, mode = "None", state = nil, elapsed = 0, wasActive = false, isModal = isModal }, { __index = Ability })
	local function toggle(mode)
		if self.isModal() or UserInputService:GetFocusedTextBox() then return end
		self.mode = self.mode == mode and "None" or mode; self.wasActive = false; self:Send()
	end
	CAS:BindAction("AdaptGlide", function(_, input)
		if input == Enum.UserInputState.Begin then toggle("Glide") end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.G, Enum.KeyCode.ButtonX)
	CAS:BindAction("AdaptClimb", function(_, input)
		if input == Enum.UserInputState.Begin then toggle("Climb") end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.E, Enum.KeyCode.ButtonY)
	CAS:BindAction("AdaptAttack", function(_, input)
		if input == Enum.UserInputState.Begin and not self.isModal() and not UserInputService:GetFocusedTextBox() then remotes.Attack:FireServer() end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonR2)
	CAS:SetTitle("AdaptGlide", "Planar"); CAS:SetTitle("AdaptClimb", "Escalar"); CAS:SetTitle("AdaptAttack", "Atacar")
	CAS:SetPosition("AdaptGlide", UDim2.new(1, -154, 1, -220))
	CAS:SetPosition("AdaptClimb", UDim2.new(1, -80, 1, -278))
	CAS:SetPosition("AdaptAttack", UDim2.new(1, -80, 1, -200))
	self.characterConnection = Players.LocalPlayer.CharacterAdded:Connect(function() self.mode = "None"; self.wasActive = false end)
	self.connection = RunService.Heartbeat:Connect(function(dt)
		self.elapsed += dt
		if self.elapsed &lt; 0.12 then return end
		self.elapsed = 0
		local char = Players.LocalPlayer.Character
		local active = char and char:GetAttribute("AbilityMode")
		if active and active ~= "None" then self.wasActive = true end
		if self.isModal() or (self.wasActive and active == "None") then self.mode = "None"; self.wasActive = false end
		if self.mode ~= "None" or self.lastSent ~= "None" then self:Send() end
	end)
	CAS:BindActionAtPriority("AdaptModalMovement", function()
		return self.isModal() and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.High.Value+1, Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Space, Enum.KeyCode.Thumbstick1)
	return self
end
function Ability:Resize(viewport)
	self.viewport = viewport
	local size = viewport and viewport.Y &lt; 450 and 52 or 62
	for i, name in { "AdaptGlide", "AdaptClimb", "AdaptAttack" } do
		CAS:SetPosition(name, UDim2.new(1, -225 + (i-1)*70, 1, -160))
		local button = CAS:GetButton(name); if button then button.Size = UDim2.fromOffset(size, size) end
	end
end
function Ability:Send()
	local char = Players.LocalPlayer.Character; local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local direction = humanoid and humanoid.MoveDirection or Vector3.zero
	self.remotes.Ability:FireServer(self.mode, direction); self.lastSent = self.mode
end
function Ability:Update(state)
	self.state = state
	local equipped = state.profile.equipped
	CAS:SetTitle("AdaptGlide", equipped.Back == "SkyWings" and "Subir" or "Planar")
	for _, pair in { { "AdaptGlide", equipped.Back ~= nil }, { "AdaptClimb", equipped.Arms ~= nil }, { "AdaptAttack", true } } do
		local button = CAS:GetButton(pair[1]); if button then button.Visible = pair[2]; button.Size = UDim2.fromOffset(62, 62) end
	end
	self:Resize(self.viewport)
	if (self.mode == "Glide" and not equipped.Back) or (self.mode == "Climb" and not equipped.Arms) then self.mode = "None"; self:Send() end
end
function Ability:Destroy()
	self.connection:Disconnect(); self.characterConnection:Disconnect()
	for _, action in { "AdaptGlide", "AdaptClimb", "AdaptAttack", "AdaptModalMovement" } do CAS:UnbindAction(action) end
end
return Ability
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">AnimationController</string>
              <string name="Source">--!nonstrict
-- Procedural limb motion uses only our rig; no uploaded animation assets.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Animation = {}
function Animation.new()
	local self = setmetatable({ rigs = {}, scan = 0, reduced = false }, { __index = Animation })
	self.connection = RunService.RenderStepped:Connect(function(dt)
		self.scan -= dt
		if self.scan &lt;= 0 then
			self.scan = 0.5; self.rigs = {}
			for _, player in Players:GetPlayers() do
				local char = player.Character; local torso = char and char:FindFirstChild("Torso")
				if torso and char:FindFirstChild("Appearance") then table.insert(self.rigs, char) end
			end
		end
		local camera = workspace.CurrentCamera
		for _, char in self.rigs do
			local root = char:FindFirstChild("HumanoidRootPart"); local torso = char:FindFirstChild("Torso")
			if not root or not torso or not camera or (root.Position - camera.CFrame.Position).Magnitude &gt; 160 then continue end
			local velocity = root.AssemblyLinearVelocity; local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
			local mode = char:GetAttribute("AbilityMode")
			local swing = math.sin(os.clock() * 10) * math.min(speed / 20, 1) * (self.reduced and 0 or 0.45)
			for _, side in { -1, 1 } do
				local name = side == -1 and "Left" or "Right"
				local hip = torso:FindFirstChild(name .. " Hip"); local shoulder = torso:FindFirstChild(name .. " Shoulder")
				if hip then hip.Transform = CFrame.Angles(swing * side, 0, 0) end
				if shoulder then shoulder.Transform = CFrame.Angles(mode == "Climb" and -1.6 + swing * side or -swing * side, 0, mode == "Glide" and side * -0.5 or 0) end
			end
		end
	end)
	return self
end
function Animation:Update(state) self.reduced = state.profile.settings.reducedMotion end
function Animation:Destroy() self.connection:Disconnect(); self.rigs = {} end
return Animation
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">ChoiceController</string>
              <string name="Source">--!nonstrict
local Shared = game:GetService("ReplicatedStorage").Shared
local Definitions = require(Shared.Adaptations)
local Gui = require(script.Parent.Gui)
local Choice = {}
function Choice.new(root, remotes)
	local self = setmetatable({}, { __index = Choice })
	self.remotes = remotes; self.cards = {}; self.token = nil; self.busy = false
	self.scrim, self.panel = Gui.modal(root, "Seu próximo corpo")
	Gui.label(self.panel, "Escolha uma adaptação. Seu corpo muda agora.", UDim2.new(1, -40, 0, 38), UDim2.fromOffset(20, 52), 15, Gui.Theme.muted)
	self.list = Gui.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(16, 104), Size = UDim2.new(1, -32, 1, -124), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 5 }, self.panel)
	self.layout = Gui.new("UIGridLayout", { CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, self.list)
	return self
end
function Choice:Resize(viewport)
	local w = math.min(viewport.X - 24, 900); local h = math.min(viewport.Y - 24, viewport.X &lt; 620 and 640 or 420)
	self.panel.Size = UDim2.fromOffset(w, h)
	local narrow = w &lt; 620
	self.layout.CellSize = narrow and UDim2.new(1, -8, 0, 150) or UDim2.new(1 / 3, -11, 1, -8)
end
function Choice:Pick(index)
	if not self.pending or self.busy then return end
	local id = self.pending.options[index]; if not id then return end
	self.busy = true
	self.remotes.Choose:FireServer(self.pending.token, id)
	for _, card in self.cards do card.AutoButtonColor = false end
	-- A dropped reply must not strand the player behind a disabled choice panel.
	local token = self.pending.token
	task.delay(2, function()
		if self.pending and self.pending.token == token then self.busy = false; self.remotes.RequestState:FireServer() end
	end)
end
function Choice:Update(state)
	self.pending = state.pending; self.scrim.Visible = state.pending ~= nil; self.busy = false
	if not state.pending then self.token = nil; return end
	if self.token == state.pending.token then return end
	self.token = state.pending.token
	for _, card in self.cards do card:Destroy() end; self.cards = {}
	for index, id in state.pending.options do
		local def = Definitions[id]; if not def then continue end
		local color = Color3.fromRGB(table.unpack(def.visualData.color))
		local card = Gui.button(self.list, "", UDim2.new(), UDim2.new(), function() self:Pick(index) end)
		card.LayoutOrder = index; card.Name = id
		Gui.stroke(card, color)
		Gui.label(card, tostring(index) .. "  /  " .. string.upper(def.slot), UDim2.new(1, -28, 0, 24), UDim2.fromOffset(14, 10), 13, color)
		Gui.label(card, def.displayName, UDim2.new(1, -28, 0, 32), UDim2.fromOffset(14, 34), 21)
		Gui.label(card, def.description, UDim2.new(1, -28, 0, 62), UDim2.fromOffset(14, 70), 15, Gui.Theme.muted)
		local old = state.profile.equipped[def.slot]
		if old then card:SetAttribute("Replaces", old) end
		table.insert(self.cards, card)
	end
	pcall(function() game:GetService("GuiService").SelectedObject = self.cards[1] end)
end
return Choice
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">CodexController</string>
              <string name="Source">--!nonstrict
local Shared = game:GetService("ReplicatedStorage").Shared
local Definitions = require(Shared.Adaptations)
local Synergies = require(Shared.Synergies)
local Areas = require(Shared.Areas)
local Gui = require(script.Parent.Gui)
local Codex = {}
function Codex.new(root, remotes)
	local self = setmetatable({}, { __index = Codex }); self.remotes = remotes
	self.scrim, self.panel = Gui.modal(root, "Seu Codex")
	Gui.button(self.panel, "Fechar", UDim2.fromOffset(76, 44), UDim2.new(1, -92, 0, 12), function() self.scrim.Visible = false end)
	self.list = Gui.new("ScrollingFrame", { Position = UDim2.fromOffset(20, 70), Size = UDim2.new(1, -40, 1, -150), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 5, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, self.panel)
	Gui.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, self.list)
	self.sound = Gui.button(self.panel, "Som: ligado", UDim2.new(0.48, -12, 0, 48), UDim2.new(0, 20, 1, -64), function() if self.state then remotes.Setting:FireServer("sound", not self.state.profile.settings.sound) end end)
	self.motion = Gui.button(self.panel, "Movimento: normal", UDim2.new(0.52, -28, 0, 48), UDim2.new(0.48, 8, 1, -64), function() if self.state then remotes.Setting:FireServer("reducedMotion", not self.state.profile.settings.reducedMotion) end end)
	return self
end
function Codex:Toggle()
	self.scrim.Visible = not self.scrim.Visible
	if self.scrim.Visible then self.remotes.Codex:FireServer(); pcall(function() game:GetService("GuiService").SelectedObject = self.sound end) end
end
function Codex:Resize(viewport)
	self.panel.Size = UDim2.fromOffset(math.min(720, viewport.X - 24), math.min(620, viewport.Y - 24))
	local narrow = viewport.X &lt; 620
	if narrow ~= self.narrow then self.narrow = narrow; self.signature = nil; if self.state then self:Update(self.state) end end
end
function Codex:Update(state)
	self.state = state
	self.sound.Text = state.profile.settings.sound and "Som: ligado" or "Som: desligado"
	self.motion.Text = state.profile.settings.reducedMotion and "Movimento: reduzido" or "Movimento: normal"
	local keys = {}
	for _, field in { "discovered", "synergies", "areas" } do
		for id, found in state.profile[field] do if found then table.insert(keys, field .. ":" .. id) end end
	end
	table.sort(keys); local signature = table.concat(keys, "|")
	if signature == self.signature then return end
	self.signature = signature
	for _, child in self.list:GetChildren() do if child:IsA("GuiObject") then child:Destroy() end end
	local index = 0
	for _, section in {
		{ title = "ADAPTAÇÕES", registry = Definitions, found = state.profile.discovered },
		{ title = "SYNERGIES SECRETAS", registry = Synergies, found = state.profile.synergies },
		{ title = "LUGARES", registry = Areas, found = state.profile.areas },
	} do
		index += 1
		local header = Gui.label(self.list, section.title, UDim2.new(1, -12, 0, 32), UDim2.new(), 14, Gui.Theme.mint); header.LayoutOrder = index
		local ids = {}; for id in section.registry do table.insert(ids, id) end; table.sort(ids)
		for _, id in ids do
			local data = section.registry[id]; local discovered = section.found[id]
			index += 1
			local row = Gui.round(Gui.new("Frame", { Size = UDim2.new(1, -12, 0, self.narrow and 128 or 104), BackgroundColor3 = Gui.Theme.panel, LayoutOrder = index }, self.list), 12)
			Gui.label(row, discovered and data.displayName or "???", UDim2.new(1, -24, 0, 28), UDim2.fromOffset(12, 6), 18)
			local description = discovered and (data.description or data.hint or "Descoberto") or "Explore e transforme-se para descobrir."
			Gui.label(row, description, UDim2.new(1, -24, 1, -42), UDim2.fromOffset(12, 34), 14, Gui.Theme.muted)
		end
	end
end
return Codex
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">EnvironmentController</string>
              <string name="Source">--!nonstrict
local CollectionService=game:GetService("CollectionService")
local Lighting=game:GetService("Lighting")
local Players=game:GetService("Players")
local TweenService=game:GetService("TweenService")
local Environment={}
local moods={
 ["VERDANT ISLAND"]={Color3.fromRGB(255,250,237),.02},
 ["EMBER ATOLL"]={Color3.fromRGB(255,225,205),.04},
 ["RIFT CROWN"]={Color3.fromRGB(226,242,255),.02},
 ["SKY REACH"]={Color3.fromRGB(235,240,255),.04},
 ["OLDGROWTH SANCTUARY"]={Color3.fromRGB(220,247,230),-.01},
 ["SUNSCAR EXPANSE"]={Color3.fromRGB(255,238,210),.03},
 ["TIDEGLASS REEFS"]={Color3.fromRGB(225,255,250),.02},
 ["VESPER HOLLOW"]={Color3.fromRGB(234,223,255),.02},
}
function Environment.new()
 local self=setmetatable({elapsed=0,emitters={},reduced=false},{__index=Environment})
 self.effect=Instance.new("ColorCorrectionEffect");self.effect.Name="LocalBiomeMood";self.effect.Parent=Lighting
 local function add(emitter) self.emitters[emitter]=true end
 for _, emitter in CollectionService:GetTagged("AmbientEmitter") do add(emitter) end
 self.added=CollectionService:GetInstanceAddedSignal("AmbientEmitter"):Connect(add)
 self.removed=CollectionService:GetInstanceRemovedSignal("AmbientEmitter"):Connect(function(e) self.emitters[e]=nil end)
 return self
end
function Environment:Area(name)
 local mood=moods[name] or {Color3.new(1,1,1),0}
 if self.tween then self.tween:Cancel() end
 self.tween=TweenService:Create(self.effect,TweenInfo.new(self.reduced and 0 or 1.6),{TintColor=mood[1],Brightness=mood[2]});self.tween:Play()
end
function Environment:Step(dt)
 self.elapsed+=dt;if self.elapsed&lt;1 then return end;self.elapsed=0
 local char=Players.LocalPlayer.Character;local root=char and char:FindFirstChild("HumanoidRootPart")
 for emitter in self.emitters do
  local parent=emitter.Parent
  if parent and parent:IsA("BasePart") then emitter.Enabled=root~=nil and not self.reduced and (parent.Position-root.Position).Magnitude&lt;460 end
 end
end
function Environment:Update(state) self.reduced=state.profile.settings.reducedMotion end
function Environment:Destroy()
 self.added:Disconnect();self.removed:Disconnect();if self.tween then self.tween:Cancel() end;self.effect:Destroy();self.emitters={}
end
return Environment
</string>
