            <Properties>
              <string name="Name">Gui</string>
              <string name="Source">--!nonstrict
local TweenService = game:GetService("TweenService")
local Gui = {}
Gui.Theme = {
	background = Color3.fromRGB(19, 23, 40), panel = Color3.fromRGB(35, 39, 62), muted = Color3.fromRGB(188, 198, 218),
	text = Color3.fromRGB(245, 248, 255), accent = Color3.fromRGB(170, 151, 255), mint = Color3.fromRGB(101, 240, 200),
	ink = Color3.fromRGB(22, 29, 44), danger = Color3.fromRGB(255, 131, 155), border = Color3.fromRGB(101, 111, 141),
}
function Gui.new(class, props, parent)
	local object = Instance.new(class)
	for key, value in props do object[key] = value end
	object.Parent = parent; return object
end
function Gui.round(object, radius)
	Gui.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) }, object)
	return object
end
function Gui.stroke(object, color)
	return Gui.new("UIStroke", { Color = color or Gui.Theme.border, Thickness = 1.5 }, object)
end
function Gui.label(parent, text, size, position, fontSize, color)
	return Gui.new("TextLabel", { Text = text, Size = size, Position = position, BackgroundTransparency = 1, FontFace = Font.fromEnum(Enum.Font.GothamMedium), TextSize = fontSize or 16, TextColor3 = color or Gui.Theme.text, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, TextWrapped = true }, parent)
end
function Gui.button(parent, text, size, position, callback, color)
	local button = Gui.round(Gui.new("TextButton", { Text = text, Size = size, Position = position, BackgroundColor3 = color or Gui.Theme.panel, TextColor3 = Gui.Theme.text, FontFace = Font.fromEnum(Enum.Font.GothamBold), TextSize = 15, AutoButtonColor = true, Selectable = true }, parent), 12)
	Gui.stroke(button)
	button.Activated:Connect(callback)
	return button
end
function Gui.modal(root, title)
	local scrim = Gui.new("Frame", { Name = title, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(), BackgroundTransparency = 0.25, Visible = false, Active = true, ZIndex = 5 }, root)
	local panel = Gui.round(Gui.new("Frame", { Size = UDim2.fromOffset(800, 480), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Gui.Theme.background }, scrim), 20)
	Gui.stroke(panel)
	Gui.label(panel, title, UDim2.new(1, -100, 0, 40), UDim2.fromOffset(20, 12), 23)
	return scrim, panel
end
function Gui.tween(object, properties, reduced)
	if reduced then for key, value in properties do object[key] = value end; return end
	TweenService:Create(object, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties):Play()
end
return Gui
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source">--!nonstrict
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Gui = require(script.Parent.Gui)
local Shared = game:GetService("ReplicatedStorage").Shared
local Areas = require(Shared.Areas)
local Choice = require(script.Parent.ChoiceController)
local Codex = require(script.Parent.CodexController)
local Journal = require(script.Parent.JournalController)
local Hud = {}
function Hud.new(remotes)
	local self = setmetatable({}, { __index = Hud }); self.remotes = remotes
	self.screen = Gui.new("ScreenGui", { Name = "ADAPT", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets, DisplayOrder = 10 }, Players.LocalPlayer:WaitForChild("PlayerGui"))
	self.root = Gui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, self.screen)
	self.hud = Gui.round(Gui.new("Frame", { Size = UDim2.fromOffset(340, 122), Position = UDim2.fromOffset(12, 12), BackgroundColor3 = Gui.Theme.background, BackgroundTransparency = 0.08 }, self.root), 16)
	Gui.stroke(self.hud)
	self.title = Gui.label(self.hud, "ADAPT!   /   BLANK", UDim2.new(1, -28, 0, 28), UDim2.fromOffset(14, 10), 17)
	self.energy = Gui.label(self.hud, "Encontrando seu mundo…", UDim2.new(1, -28, 0, 25), UDim2.fromOffset(14, 37), 14, Gui.Theme.muted)
	self.track = Gui.round(Gui.new("Frame", { Size = UDim2.new(1, -28, 0, 12), Position = UDim2.fromOffset(14, 68), BackgroundColor3 = Gui.Theme.panel, ClipsDescendants = true }, self.hud), 6)
	self.fill = Gui.round(Gui.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Gui.Theme.mint }, self.track), 6)
	self.health = Gui.label(self.hud, "Vida 100  •  habilidade 100%", UDim2.new(1, -28, 0, 24), UDim2.fromOffset(14, 88), 13, Gui.Theme.muted)
	self.codexButton = Gui.button(self.root, "CODEX [C]", UDim2.fromOffset(120, 48), UDim2.new(1, -132, 0, 12), function() if not self.choice.scrim.Visible then self.codex:Toggle() end end)
	self.guide = Gui.round(Gui.new("Frame", { Size = UDim2.new(0, 440, 0, 68), Position = UDim2.new(0.5, 0, 1, -20), AnchorPoint = Vector2.new(0.5, 1), BackgroundColor3 = Gui.Theme.background, BackgroundTransparency = 0.08 }, self.root), 16)
	self.guideText = Gui.label(self.guide, "Toque os cristais verdes. Sua primeira evolução está perto.", UDim2.new(1, -28, 1, -12), UDim2.fromOffset(14, 6), 15)
	self.toast = Gui.round(Gui.new("TextLabel", { Size = UDim2.fromOffset(420, 68), Position = UDim2.new(0.5, 0, 0, 145), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Gui.Theme.panel, TextColor3 = Gui.Theme.text, FontFace = Font.fromEnum(Enum.Font.GothamBold), TextSize = 17, TextWrapped = true, Visible = false, ZIndex = 8 }, self.root), 14)
	self.mode = Gui.label(self.root, "", UDim2.fromOffset(440, 44), UDim2.new(0.5, -220, 1, -132), 13, Gui.Theme.muted); self.mode.TextXAlignment = Enum.TextXAlignment.Center
	self.choice = Choice.new(self.root, remotes); self.codex = Codex.new(self.root, remotes)
	self.journal = Journal.new(self.root, remotes, function() self.codex:Toggle() end)
	self.journalButton = Gui.button(self.root, "DIÁRIO [C]", UDim2.fromOffset(120, 48), UDim2.new(1, -132, 0, 68), function()
		if not self.choice.scrim.Visible then self.codex.scrim.Visible = false; self.journal:Toggle() end
	end, Gui.Theme.accent); self.journalButton.TextColor3 = Gui.Theme.ink
	self.codexButton.Text = "CODEX"; self.codexButton.Activated:Connect(function() self.journal:Close() end)
	self.saveStatus = Gui.label(self.root, "", UDim2.fromOffset(340, 22), UDim2.fromOffset(14, 133), 12, Gui.Theme.muted)
	self.debug = Gui.new("ScrollingFrame", { Position = UDim2.new(1, -232, 0, 126), Size = UDim2.fromOffset(220, 265), BackgroundColor3 = Gui.Theme.background, Visible = false, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 4, ZIndex = 4 }, self.root)
	Gui.round(self.debug, 12); Gui.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, self.debug)
	self.debugButton = Gui.button(self.root, "DEV", UDim2.fromOffset(64, 44), UDim2.new(1, -76, 0, 124), function() self.debug.Visible = not self.debug.Visible end); self.debugButton.Visible = false
	for i, item in {
		{ "+60 energia", "energy", 60 }, { "Equipar Wings", "grant", "Wings" }, { "Equipar Grip Claws", "grant", "GripClaws" }, { "Equipar Night Eyes", "grant", "NightEyes" },
		{ "Resetar build", "reset" }, { "Ir para Wilds", "teleport", "Wilds" }, { "Ir para Cliff", "teleport", "Cliff" }, { "Ir para Cave", "teleport", "Cave" }, { "Ir para Sky Island", "teleport", "SkyIsland" }, { "Imprimir estado", "state" },
	} do
		local button = Gui.button(self.debug, item[1], UDim2.new(1, -8, 0, 44), UDim2.new(), function() remotes.Debug:FireServer(item[2], item[3]) end); button.LayoutOrder = i
	end
	local ids = {}; for id in Areas do if id ~= "Wilds" and id ~= "Cliff" and id ~= "Cave" and id ~= "SkyIsland" then table.insert(ids,id) end end; table.sort(ids)
	for i,id in ids do
		local button = Gui.button(self.debug,"Ir: "..Areas[id].displayName,UDim2.new(1,-8,0,44),UDim2.new(),function() remotes.Debug:FireServer("teleport",id) end)
		button.TextSize = 12; button.LayoutOrder = 20+i
	end
	self.toastSerial = 0
	return self
end
function Hud:Resize(viewport)
	local small = viewport.X &lt; 620
	self.hud.Size = UDim2.fromOffset(math.min(340, viewport.X - 156), 122)
	self.title.TextSize = small and 14 or 17
	self.guide.Size = UDim2.fromOffset(math.min(440, viewport.X - 32), 84)
	if UserInputService.TouchEnabled then
		self.guide.Position = UDim2.new(0.5, 0, 0, 144); self.guide.AnchorPoint = Vector2.new(0.5, 0)
		self.mode.Visible = false; self.codexButton.Text = "CODEX"
	else self.guide.Position = UDim2.new(0.5, 0, 1, -20); self.guide.AnchorPoint = Vector2.new(0.5, 1) end
	self.toast.Size = UDim2.fromOffset(math.min(420, viewport.X - 32), 68)
	self.mode.Size = UDim2.fromOffset(math.min(440, viewport.X - 24), 44); self.mode.Position = UDim2.new(0.5, 0, 1, -164); self.mode.AnchorPoint = Vector2.new(0.5, 0)
	self.choice:Resize(viewport); self.codex:Resize(viewport)
	self.journal:Resize(viewport)
	self.guide.Position = UserInputService.TouchEnabled and UDim2.new(.5, 0, 0, 170) or UDim2.new(.5, 0, 1, -20)
	self.guideText.TextSize = small and 13 or 15
	self.toast.Position = UDim2.new(.5, 0, 0, UserInputService.TouchEnabled and 266 or 172)
	self.saveStatus.Size = UDim2.fromOffset(math.min(340, viewport.X-100), 30)
	self.journalButton.Text = UserInputService.TouchEnabled and "DIÁRIO" or "DIÁRIO [C]"
	self.health.TextSize = small and 12 or 13
	if UserInputService.TouchEnabled and viewport.Y &lt; 450 and viewport.X &gt;= 620 then
		self.hud.Size = UDim2.fromOffset(230,122)
		self.guide.Size = UDim2.fromOffset(viewport.X-390,112)
		self.guide.Position = UDim2.fromOffset(254,12); self.guide.AnchorPoint = Vector2.zero
		self.guideText.TextSize = 13; self.toast.Position = UDim2.new(.5,0,0,172)
		self.toast.Size = UDim2.fromOffset(math.min(360,viewport.X-32),44)
	end
end
function Hud:Message(text)
	self.toastSerial += 1; local serial = self.toastSerial
	self.toast.Text = text; self.toast.Visible = true
	task.delay(3.5, function() if serial == self.toastSerial then self.toast.Visible = false end end)
end
function Hud:Update(state)
	self.state = state
	local p = state.profile
	self.title.Text = "ADAPT!   /   NÍVEL " .. p.level
	self.energy.Text = string.format("%d / %d  •  energia", p.energy, state.threshold)
	Gui.tween(self.fill, { Size = UDim2.fromScale(math.clamp(p.energy / state.threshold, 0, 1), 1) }, p.settings.reducedMotion)
	self.choice:Update(state); self.codex:Update(state)
	self.journal:Update(state)
	if state.pending then self.codex.scrim.Visible = false; self.debug.Visible = false end
	self.debugButton.Visible = state.debug == true
	local controls = {}
	if p.equipped.Back then table.insert(controls, "[G] Planar") end
	if p.equipped.Arms then table.insert(controls, "[E] Escalar") end
	if p.equipped.Head then table.insert(controls, "Visão noturna ativa") end
	table.insert(controls, "[F] Atacar")
	self.mode.Text = table.concat(controls, "  •  ")
	if p.equipped.Back == "SkyWings" then self.mode.Text = self.mode.Text:gsub("Planar", "Ascender") end
	if p.level == 0 then self.guideText.Text = "Siga o sinal e toque os cristais verdes para evoluir."
	elseif p.equipped.Back and not p.areas.SkyIsland then self.guideText.Text = "Wings: suba a rampa oeste. Salte e use Planar [G] até a ilha."
	elseif p.equipped.Arms and not p.areas.Cliff then self.guideText.Text = "Grip Claws: chegue às marcas douradas e use Escalar [E]."
	elseif p.equipped.Head and not p.areas.Cave then self.guideText.Text = "Night Eyes: entre na caverna e encontre a essência oculta."
	else self.guideText.Text = "Explore, combine adaptações e enfrente o Guardian. [C] abre o Codex." end
	if state.journey then self.guideText.Text = state.journey.objective.title .. " • " .. state.journey.objective.text end
	self.saveStatus.Text = state.persistence == "Cloud" and "Progresso com salvamento automático" or state.persistence == "ReadOnly" and "SEM SALVAMENTO • dados indisponíveis" or "TESTE LOCAL • progresso temporário"
	if self.lastPersistence ~= state.persistence then
		self.lastPersistence = state.persistence
		if state.persistence == "ReadOnly" then self:Message("Dados indisponíveis: esta sessão não será salva.") end
	end
end
function Hud:Vitals(health, stamina, mode)
	self.health.Text = string.format("Vida %d  •  %s %d%%", math.ceil(health), mode == "None" and "habilidade" or mode, math.floor(stamina * 100))
	local char = Players.LocalPlayer.Character
	if char and char:GetAttribute("HeatDanger") then self.health.Text = "CALOR INTENSO • equipe Carapaça de Brasa"
	elseif char and (char:GetAttribute("Oxygen") or 1) &lt; 1 then self.health.Text = string.format("Vida %d • Ar %d%% • suba!", math.ceil(health), math.floor(char:GetAttribute("Oxygen")*100)) end
end
function Hud:IsModal() return self.choice.scrim.Visible or self.codex.scrim.Visible or self.journal.scrim.Visible end
return Hud
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">JournalController</string>
              <string name="Source">--!nonstrict
local Shared = game:GetService("ReplicatedStorage").Shared
local Players = game:GetService("Players")
local Journey = require(Shared.Journey)
local Locations = require(Shared.JourneyLocations)
local Definitions = require(Shared.Adaptations)
local World = require(Shared.WorldDefinition)
local Gui = require(script.Parent.Gui)
local Journal = {}
function Journal.new(root, remotes, openCodex)
	local self = setmetatable({ remotes = remotes, tab = "Jornada", rows = {}, tracking = nil }, { __index = Journal })
	self.scrim, self.panel = Gui.modal(root, "ADAPT!  /  Diário")
	Gui.button(self.panel, "Voltar", UDim2.fromOffset(78, 44), UDim2.new(1, -94, 0, 12), function() self:Close() end)
	self.tabs = {}
	for i, name in { "Jornada", "Mapa", "Corpo" } do
		local b = Gui.button(self.panel, name, UDim2.new(1/3, -20, 0, 44), UDim2.new((i-1)/3, 16, 0, 64), function() self.tab = name; self:Render() end)
		self.tabs[name] = b
	end
	self.list = Gui.new("ScrollingFrame", { Position = UDim2.fromOffset(16, 120), Size = UDim2.new(1, -32, 1, -238), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, self.panel)
	Gui.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, self.list)
	self.primary = Gui.button(self.panel, "CONTINUAR", UDim2.new(.5, -22, 0, 48), UDim2.new(0, 16, 1, -104), function()
		if self.state and not self.state.profile.journey.started then self.remotes.Journey:FireServer("intro", "") end
		self:Close()
	end, Gui.Theme.mint); self.primary.TextColor3 = Gui.Theme.ink
	self.codex = Gui.button(self.panel, "Codex e opções", UDim2.new(.5, -22, 0, 48), UDim2.new(.5, 6, 1, -104), function() self:Close(); openCodex() end)
	self.rescue = Gui.button(self.panel, "Voltar ao refúgio • resgate", UDim2.new(1, -32, 0, 44), UDim2.new(0, 16, 1, -52), function() remotes.Journey:FireServer("rescue", ""); self:Close() end)
	self.rescue.TextSize = 13
	return self
end
function Journal:Close() self.scrim.Visible = false end
function Journal:Toggle(tab)
	if tab then self.tab = tab; self.scrim.Visible = true else self.scrim.Visible = not self.scrim.Visible end
	if self.scrim.Visible then self:Render(); pcall(function() game:GetService("GuiService").SelectedObject = self.primary end) end
end
function Journal:Resize(viewport)
	self.panel.Size = UDim2.fromOffset(math.min(820, viewport.X-24), math.min(710, viewport.Y-24))
	self.narrow = viewport.X &lt; 620
	if self.state then self:Render() end
end
function Journal:Row(title, description, color, action, callback)
	local height = self.narrow and 176 or 124
	local row = Gui.round(Gui.new("Frame", { Size = UDim2.new(1, -8, 0, height), BackgroundColor3 = Gui.Theme.panel, LayoutOrder = #self.rows+1 }, self.list), 12)
	Gui.new("Frame", { Size = UDim2.new(0, 3, 1, -24), Position = UDim2.fromOffset(0, 12), BackgroundColor3 = color, BorderSizePixel = 0 }, row)
	Gui.label(row, title, UDim2.new(1, -28, 0, 30), UDim2.fromOffset(14, 6), 17, color)
	Gui.label(row, description, UDim2.new(1, -28, 0, self.narrow and 74 or 32), UDim2.fromOffset(14, 36), 14, Gui.Theme.muted)
	if action then
		local button = Gui.button(row, action, UDim2.new(1, -28, 0, 36), UDim2.new(0, 14, 1, -42), callback)
		button.Size = UDim2.new(1, -28, 0, 44); button.Position = UDim2.new(0, 14, 1, -48); button.TextSize = 13
	end
	table.insert(self.rows, row); return row
end
function Journal:RenderMap()
	local frame = Gui.round(Gui.new("Frame", { Size = UDim2.new(1, -8, 0, self.narrow and 290 or 380), BackgroundColor3 = Color3.fromRGB(23, 57, 68), LayoutOrder = 0, ClipsDescendants = true }, self.list), 14)
	table.insert(self.rows, frame)
	local function map(p) return (p[1]+1850)/3700, (p[#p]+1700)/3400 end
	for _, island in World.islands do
		local x, y = map(island.center)
		local land = Gui.round(Gui.new("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(x,y), Size = UDim2.fromScale(island.radius[1]*2/3700, island.radius[2]*2/3400), BackgroundColor3 = Color3.fromRGB(table.unpack(island.palette)), BackgroundTransparency = .18, BorderSizePixel = 0 }, frame), 70)
		land.Rotation = island.id == "Hollow" and 20 or -8
	end
	for i, area in Journey.order do
		local x, y = map(Locations.camps[area]); local j = self.state.profile.journey
		local b = Gui.button(frame, tostring(i) .. (j.seals[area] and " ✓" or ""), UDim2.fromOffset(44,44), UDim2.fromScale(x,y), function() self.tracking = area; self:Close() end, Color3.fromRGB(table.unpack(Journey.regions[area].color)))
		b.AnchorPoint = Vector2.new(.5,.5); b.TextColor3 = Gui.Theme.ink; b.TextSize = 13
	end
	local char = Players.LocalPlayer.Character; local part = char and char:FindFirstChild("HumanoidRootPart")
	if part then
		local x,y = map({part.CFrame.Position.X,part.CFrame.Position.Z})
		local marker = Gui.round(Gui.new("Frame", { Size = UDim2.fromOffset(10,10), Position = UDim2.fromScale(x,y), AnchorPoint = Vector2.new(.5,.5), BackgroundColor3 = Gui.Theme.text, BorderSizePixel = 0, ZIndex = 3 }, frame), 5)
		Gui.stroke(marker, Gui.Theme.ink)
	end
	for i, area in Journey.order do
		local j = self.state.profile.journey; local region = Journey.regions[area]
		local status = j.seals[area] and "Semente restaurada" or j.camps[area] and "Refúgio descoberto" or "Explore para descobrir o refúgio"
		self:Row(i .. "  " .. region.name, status, Color3.fromRGB(table.unpack(region.color)), j.camps[area] and "Viajar • a partir de um refúgio" or "Marcar no mundo", function()
			if j.camps[area] then self.remotes.Travel:FireServer(area) else self.tracking = area end
			self:Close()
		end)
	end
end
function Journal:Render()
	if not self.state then return end
	for _, row in self.rows do row:Destroy() end; self.rows = {}
	for name, b in self.tabs do b.BackgroundColor3 = name == self.tab and Gui.Theme.accent or Gui.Theme.panel; b.TextColor3 = name == self.tab and Gui.Theme.ink or Gui.Theme.text end
	local p = self.state.profile; local j = p.journey
	self.primary.Text = j.started and "CONTINUAR EXPLORANDO" or "COMEÇAR A JORNADA"; self.primary.TextSize = self.narrow and 12 or 14
	if self.tab == "Mapa" then self:RenderMap(); return end
	if self.tab == "Corpo" then
		local char = Players.LocalPlayer.Character
		if char and char.PrimaryPart then
			local preview = Gui.round(Gui.new("ViewportFrame", { Size = UDim2.new(1,-8,0,220), BackgroundColor3 = Gui.Theme.background, Ambient = Color3.fromRGB(180,195,210), LightColor = Color3.fromRGB(255,236,208), LightDirection = Vector3.new(-1,-1,-1), LayoutOrder = 0 }, self.list), 14)
			local model = char:Clone()
			if model then
				for _, item in model:GetDescendants() do
					if item:IsA("Script") or item:IsA("LocalScript") or item:IsA("ForceField") then item:Destroy()
					elseif item:IsA("BasePart") then item.Anchored = true end
				end
				local worldModel = Instance.new("WorldModel"); worldModel.Parent = preview; model.Parent = worldModel; model:PivotTo(CFrame.identity)
				local camera = Instance.new("Camera"); camera.FieldOfView = 35; camera.CFrame = CFrame.lookAt(Vector3.new(8,4,-18), Vector3.new(0,.1,0)); camera.Parent = preview; preview.CurrentCamera = camera
			end
			table.insert(self.rows, preview)
		end
		self:Row("Seu corpo, seus caminhos", "Troque adaptações descobertas perto de um refúgio. Cada parte tem um único slot.", Gui.Theme.mint)
		for _, slot in { "Head", "Body", "Arms", "Legs", "Back", "Tail" } do
			local ids = {}; for id, d in Definitions do if d.slot == slot and p.discovered[id] then table.insert(ids,id) end end; table.sort(ids)
			for _, id in ids do
				local d = Definitions[id]; local equipped = p.equipped[slot] == id
				self:Row(d.displayName .. (equipped and " • equipado" or ""), d.description, Color3.fromRGB(table.unpack(d.visualData.color)), equipped and "Equipado" or "Equipar no refúgio", function() if not equipped then self.remotes.Equip:FireServer(id) end end)
			end
		end
		return
	end
	if not j.started then
		self:Row("UM CORPO EM BRANCO", "Você chegou a um arquipélago adormecido. Cada descoberta muda seu corpo e abre um caminho.", Gui.Theme.mint)
		self:Row("EXPLORE. TRANSFORME-SE. DESPERTE.", "Colete essência, evolua e restaure oito sementes. Derrote os guardiões junto de outros exploradores.", Gui.Theme.accent)
		self:Row("Encontre seu ritmo", "WASD / direcional: mover. Espaço: saltar. G: asas. E: garras. F: atacar. R: interagir. C: diário.", Gui.Theme.text)
	elseif j.complete then
		self:Row("O ARQUIPÉLAGO DESPERTOU", "Você reuniu oito sementes e alcançou o Zênite. Sua coroa de Guardião do Arquipélago celebra essa jornada.", Color3.fromRGB(255, 220, 130))
		self:Row("O mundo continua aberto", "Todas as descobertas permanecem com você. Complete o Codex, ajude novos exploradores e experimente combinações.", Gui.Theme.mint)
		self:Row("ADAPT! • versão 1.0", "Uma aventura original de transformação e exploração. Obrigado por dar vida a este mundo.", Gui.Theme.muted)
	end
	local objective = self.state.journey and self.state.journey.objective or Journey.objective(p)
	self:Row("AGORA • " .. objective.title, objective.text, Gui.Theme.mint, "Seguir objetivo da jornada", function() self.tracking = nil; self:Close() end)
	for i, area in Journey.order do
		local region = Journey.regions[area]; local n = 0
		for _, id in region.runes do if j.runes[id] then n += 1 end end
		self:Row(string.format("%02d  %s%s", i, region.name, j.seals[area] and " ✓" or ""), j.seals[area] and region.lore or string.format("Memórias %d/3. %s", n, region.reward and ("Recompensa: " .. Definitions[region.reward].displayName) or "Restaure a semente deste bioma."), Color3.fromRGB(table.unpack(region.color)), if j.seals[area] then nil else "Marcar próximo passo", function() self.tracking = area; self:Close() end)
	end
end
function Journal:Update(state)
	self.state = state
	if not state.profile.journey.started and not self.introShown then self.introShown = true; self.scrim.Visible = true end
	if state.profile.journey.complete and not self.wasComplete then
		if self.wasComplete == false then self.tab = "Jornada"; self.scrim.Visible = true end
	end
	self.wasComplete = state.profile.journey.complete
	if state.pending then self.scrim.Visible = false end
	if self.scrim.Visible then self:Render() end
end
function Journal:Target()
	if not self.state then return nil end
	local j = self.state.profile.journey
	if self.tracking then
		local area = self.tracking; local region = Journey.regions[area]
		if not j.seals[area] then
			for _, id in region.runes do if not j.runes[id] then return { title = "Memória • " .. region.name, position = Locations.runes[id].position } end end
		end
		return { title = region.name, position = Locations.camps[area] }
	end
	return self.state.journey and self.state.journey.objective or Journey.objective(self.state.profile)
end
return Journal
</string>
