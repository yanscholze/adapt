	Lumen = { id = "Lumen", displayName = "Essência oculta", rarity = "Rare", energyValue = 18, visual = { color = { 199, 143, 255 }, size = 1.7 }, spawn = { respawnSeconds = 24, requiredAbility = "NightVision" } },
