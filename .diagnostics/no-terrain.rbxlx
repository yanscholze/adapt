        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">PersistenceService</string>
            <string name="Source">--!nonstrict
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Schema = require(Shared.ProfileSchema)
local Adaptations = require(Shared.Adaptations)
local Synergies = require(Shared.Synergies)
local Areas = require(Shared.Areas)
local Persistence = {}
function Persistence:Init()
	self.sessions = {}; self.closing = false
	self.enabled = not RunService:IsStudio() or Config.StudioPersistence
	if self.enabled then self.store = DataStoreService:GetDataStore(Config.DataStoreName) end
end
function Persistence:Load(player)
	local session = { id = HttpService:GenerateGUID(false), writable = false, saving = false, releasing = false }
	self.sessions[player] = session
	if not self.enabled then return Schema.defaults(), "StudioMemory" end
	local loaded; local locked = false
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return self.store:UpdateAsync("u_" .. player.UserId, function(record)
				if record ~= nil and type(record) ~= "table" then error("Invalid stored envelope") end
				if record and (record.version or 0) &gt; Config.SchemaVersion then error("Newer schema: refusing downgrade") end
				local lease = record and record.session
				if lease and lease.id ~= session.id and (lease.expires or 0) &gt; os.time() then locked = true; return nil end
				if record and type(record.data) ~= "table" then error("Invalid stored profile") end
				loaded = Schema.sanitize(record and record.data, Adaptations, Synergies, Areas)
				return { version = Config.SchemaVersion, data = loaded, session = { id = session.id, expires = os.time() + Config.SessionLeaseSeconds } }
			end)
		end)
		if locked then self.sessions[player] = nil; return nil, "Locked" end
		if ok and result and loaded then session.writable = true; return loaded, "Cloud" end
		warn("[ADAPT] Profile load failed, attempt", attempt, "user", player.UserId)
		if attempt &lt; 3 then task.wait(attempt) end
	end
	-- A failed load must never overwrite a real cloud save with defaults.
	return Schema.defaults(), "ReadOnly"
end
function Persistence:Save(player, profile, release)
	local session = self.sessions[player]
	if not session then return false end
	if release then session.releasing = true end
	local deadline = os.clock() + 12
	while session.saving and os.clock() &lt; deadline do task.wait(0.1) end
	if session.saving then return false end
	if self.sessions[player] ~= session then return true end
	if not self.enabled or not session.writable then
		if release then self.sessions[player] = nil end
		return not self.enabled
	end
	-- An autosave scheduled before removal cannot reclaim a released lease.
	if session.releasing and not release then return false end
	session.saving = true
	local snapshot = Schema.sanitize(profile, Adaptations, Synergies, Areas)
	local success = false
	for attempt = 1, 3 do
		local leaseLost = false
		local ok, result = pcall(function()
			return self.store:UpdateAsync("u_" .. player.UserId, function(record)
				if not record or not record.session or record.session.id ~= session.id then leaseLost = true; return nil end
				return { version = Config.SchemaVersion, data = snapshot, session = not release and { id = session.id, expires = os.time() + Config.SessionLeaseSeconds } or nil }
			end)
		end)
		if leaseLost then session.writable = false; player:Kick("Sua sessão de dados mudou. Entre novamente para proteger seu progresso."); break end
		if ok and result then success = true; break end
		if attempt &lt; 3 then task.wait(attempt) end
	end
	session.saving = false
	if release then self.sessions[player] = nil end
	if not success then warn("[ADAPT] Save failed for", player.UserId, "(previous cloud data preserved)") end
	return success
end
return Persistence
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source">--!nonstrict
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)
local Adaptations = require(Shared.Adaptations)
local Synergies = require(Shared.Synergies)
local HttpService = game:GetService("HttpService")
local PlayerService = {}
function PlayerService:Init(remotes, persistence, analytics)
	self.remotes = remotes; self.persistence = persistence; self.analytics = analytics
	self.records = {}; self.random = Random.new(); self.onBuildChanged = nil
end
function PlayerService:Get(player) return self.records[player] end
function PlayerService:Send(player)
	local r = self:Get(player); if not r then return end
	local p = r.profile
	local active = Progression.synergies(p.equipped, Adaptations, Synergies)
	for _, id in active do p.synergies[id] = true end
	if r.levelStat then r.levelStat.Value = p.level end
	self.remotes.State:FireClient(player, { profile = p, threshold = Progression.threshold(p.level), pending = r.pending, activeSynergies = active, persistence = r.mode, debug = r.debug, journey = self.journey and self.journey:Snapshot(player) or nil })
end
function PlayerService:ReadyEvolution(player)
	local r = self:Get(player); if not r or r.pending then return end
	if r.profile.energy &lt; Progression.threshold(r.profile.level) then return end
	local options = Progression.options(r.profile, Adaptations, self.random)
	if #options == 0 then return end
	r.pending = { token = HttpService:GenerateGUID(false), options = options }
	self.analytics:Once(player, r.profile, "FIRST_EVOLUTION_READY")
end
function PlayerService:Add(player, debugAllowed)
	local profile, mode = self.persistence:Load(player)
	if not player.Parent then if profile then self.persistence:Save(player, profile, true) end; return false end
	if not profile then player:Kick("Seu progresso ainda está aberto em outro servidor. Aguarde alguns segundos e tente novamente."); return false end
	local stats = Instance.new("Folder"); stats.Name = "leaderstats"; stats.Parent = player
	local level = Instance.new("IntValue"); level.Name = "Evolution"; level.Value = profile.level; level.Parent = stats
	self.records[player] = { profile = profile, mode = mode, levelStat = level, debug = debugAllowed, currentArea = nil }
	self.analytics:Once(player, profile, "FTUE_STARTED")
	self:ReadyEvolution(player)
	return true
end
function PlayerService:Energy(player, amount, source)
	local r = self:Get(player); if not r then return end
	if type(amount) ~= "number" or amount ~= amount or amount &lt;= 0 then return end
	r.profile.energy = math.min(Config.MaxBankedEnergy, r.profile.energy + math.floor(amount))
	if source == "Essence" then self.analytics:Once(player, r.profile, "FIRST_ESSENCE") end
	self:ReadyEvolution(player); self:Send(player)
end
function PlayerService:Choose(player, token, id)
	local r = self:Get(player)
	if not r or not r.pending or type(token) ~= "string" or type(id) ~= "string" then return false end
	if r.pending.token ~= token or not table.find(r.pending.options, id) then return false end
	local definition = Adaptations[id]; local p = r.profile
	if not definition or p.energy &lt; Progression.threshold(p.level) or definition.requirements.minLevel &gt; p.level then return false end
	p.energy -= Progression.threshold(p.level); p.level += 1; p.discovered[id] = true; p.equipped[definition.slot] = id; r.pending = nil
	local newlyFound = {}
	for _, synergy in Progression.synergies(p.equipped, Adaptations, Synergies) do
		if not p.synergies[synergy] then table.insert(newlyFound, Synergies[synergy].displayName) end
		p.synergies[synergy] = true
	end
	self.analytics:Once(player, p, "FIRST_ADAPTATION_SELECTED")
	if self.onBuildChanged then self.onBuildChanged(player) end
	self.remotes.Feedback:FireClient(player, "Evolution", definition.displayName)
	for _, name in newlyFound do self.remotes.Feedback:FireClient(player, "Synergy", name) end
	self:ReadyEvolution(player); self:Send(player); return true
end
function PlayerService:Remove(player)
	local r = self:Get(player); if not r then return end
	self.persistence:Save(player, r.profile, true); self.records[player] = nil
end
return PlayerService
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source">--!nonstrict
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Areas = require(Shared.Areas)
local Definition = require(Shared.WorldDefinition)
local Archipelago = require(script.Parent.Parent.World.Archipelago)
local Samples = require(Shared.WorldSamples)
local World = {}
local colors = { grass = Color3.fromRGB(82, 153, 129), rock = Color3.fromRGB(76, 83, 108), sand = Color3.fromRGB(229, 207, 164), gold = Color3.fromRGB(255, 194, 91) }
local function part(parent, name, size, position, color, material)
	local p = Instance.new("Part")
	p.Name = name; p.Size = size; p.CFrame = CFrame.new(position); p.Anchored = true
	p.Color = color; p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent; return p
end
local function sign(parent, text, position, color)
	local post = part(parent, "Sign", Vector3.new(0.4, 5, 0.4), position, colors.rock)
	local gui = Instance.new("BillboardGui"); gui.Size = UDim2.fromOffset(280, 68); gui.StudsOffset = Vector3.new(0, 4, 0); gui.MaxDistance = 140; gui.Parent = post
	local label = Instance.new("TextLabel"); label.Size = UDim2.fromScale(1, 1); label.BackgroundColor3 = colors.rock; label.BackgroundTransparency = 0.12
	label.Text = text; label.TextColor3 = color or Color3.new(1, 1, 1); label.FontFace = Font.fromEnum(Enum.Font.GothamBold); label.TextSize = 16; label.TextWrapped = true; label.Parent = gui
	local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 12); corner.Parent = label
end
function World:Init(force)
	local old = workspace:FindFirstChild("ADAPTWorld")
	if old and old:GetAttribute("WorldVersion") == Definition.version and not force then
		self.model = old; self.core = old:FindFirstChild("Core"); self:Metadata(); return
	end
	if old then old:Destroy() end
	self.model = Instance.new("Model"); self.model.Name = "ADAPTWorld"; self.model.Parent = workspace
	self.essenceSpawns = {}; self.areaVolumes = {}; self.areaOrder = {}
	local m = self.model
	part(m, "Wilds", Vector3.new(220, 8, 180), Vector3.new(0, -4, 10), colors.grass, Enum.Material.Grass)
	part(m, "Arrival", Vector3.new(16, 0.2, 16), Vector3.new(0, 0.1, 20), colors.sand)
	local spawn = Instance.new("SpawnLocation"); spawn.Name = "WildsSpawn"; spawn.Size = Vector3.new(8, 0.3, 8); spawn.CFrame = CFrame.new(0, 0.35, 20); spawn.Anchored = true; spawn.Transparency = 1; spawn.CanCollide = false; spawn.Neutral = true; spawn.Duration = 0; spawn.Parent = m
	sign(m, "ADAPT!\nToque os cristais • descubra seu próximo corpo", Vector3.new(0, 2.5, 7))
	for i = 1, 8 do
		local x = -18 + i * 5
		part(m, "Trail", Vector3.new(3.8, 0.15, 4), Vector3.new(x, 0.15, -4), colors.sand)
	end
	for i, pos in { Vector3.new(-23, 1.5, 9), Vector3.new(22, 2, 25), Vector3.new(-35, 1.5, -12), Vector3.new(40, 2, 54) } do
		local stone = part(m, "Pebble" .. i, Vector3.new(6, pos.Y * 2, 5), pos, colors.rock); stone.Shape = Enum.PartType.Ball
	end
	-- Claws route. Only this face has the climb tag; adjacent walls remain ordinary rock.
	part(m, "CliffMass", Vector3.new(38, 44, 50), Vector3.new(70, 22, 35), colors.rock, Enum.Material.Slate)
	part(m, "CliffMeadow", Vector3.new(38, 1, 50), Vector3.new(70, 44.5, 35), colors.grass, Enum.Material.Grass)
	local climb = part(m, "ClimbFace", Vector3.new(13, 44, 0.5), Vector3.new(70, 22, 9.7), Color3.fromRGB(123, 102, 80), Enum.Material.Rock)
	CollectionService:AddTag(climb, "Climbable")
	for y = 4, 40, 6 do
		local mark = part(m, "GripMark", Vector3.new(5, 0.3, 0.2), Vector3.new(70, y, 9.35), colors.gold, Enum.Material.Neon)
		mark.CanCollide = false; mark.CanQuery = false
	end
	sign(m, "CLIFF\nGrip Claws • aproxime-se e use Escalar", Vector3.new(65, 2.5, -2), colors.gold)
	-- Public ramp gives Wings-first players independent access to a launch point.
	local from = Vector3.new(-63, 1, -65); local to = Vector3.new(28, 63, -65)
	local ramp = part(m, "SkyRamp", Vector3.new(12, 2, (to - from).Magnitude), (from + to) / 2, colors.rock, Enum.Material.Slate)
	ramp.CFrame = CFrame.lookAt((from + to) / 2, to)
	part(m, "LaunchDeck", Vector3.new(20, 2, 22), Vector3.new(31, 62.5, -65), colors.grass)
	sign(m, "ROTA DO CÉU\nSuba a rampa • salte • use Planar", Vector3.new(-58, 2.5, -53), Color3.fromRGB(170, 190, 255))
	sign(m, "SKY ISLAND →\nSalte e abra as asas", Vector3.new(36, 66, -65))
	part(m, "SkyIsland", Vector3.new(32, 7, 32), Vector3.new(118, 32, -65), colors.rock, Enum.Material.Slate)
	part(m, "SkyTurf", Vector3.new(32, 1, 32), Vector3.new(118, 36, -65), colors.grass, Enum.Material.Grass)
	local underside = part(m, "SkyCrystal", Vector3.new(20, 22, 20), Vector3.new(118, 19, -65), Color3.fromRGB(138, 118, 187)); underside.Shape = Enum.PartType.Ball
	sign(m, "SKY ISLAND\nAsas levam a novas possibilidades", Vector3.new(118, 39, -65))
	-- A lightproof cave shell, with an open entrance on the south side.
	local caveColor = Color3.fromRGB(40, 43, 65)
	part(m, "CaveBack", Vector3.new(44, 22, 3), Vector3.new(-64, 11, 73), caveColor, Enum.Material.Slate)
	part(m, "CaveLeft", Vector3.new(3, 22, 43), Vector3.new(-86, 11, 53), caveColor, Enum.Material.Slate)
	part(m, "CaveRight", Vector3.new(3, 22, 43), Vector3.new(-42, 11, 53), caveColor, Enum.Material.Slate)
	part(m, "CaveRoof", Vector3.new(47, 3, 45), Vector3.new(-64, 23, 53), caveColor, Enum.Material.Slate)
	part(m, "CaveEntranceLeft", Vector3.new(13, 20, 3), Vector3.new(-79, 10, 31), caveColor)
	part(m, "CaveEntranceRight", Vector3.new(13, 20, 3), Vector3.new(-49, 10, 31), caveColor)
	sign(m, "CAVE\nAlguma coisa brilha além da escuridão…", Vector3.new(-64, 2.5, 23), Color3.fromRGB(138, 255, 210))
	for i = 1, 5 do
		local hidden = part(m, "HiddenGlyph", Vector3.new(2, 0.15, 2), Vector3.new(-64, 0.25, 39 + i * 5), Color3.fromRGB(101, 255, 205), Enum.Material.Neon)
		hidden.Transparency = 1; hidden.CanCollide = false; CollectionService:AddTag(hidden, "NightVisionRevealable")
	end
	-- Guardian is on a short, readable route from the safe spawn.
	part(m, "GuardianArena", Vector3.new(30, 0.3, 26), Vector3.new(20, 0.2, 70), Color3.fromRGB(111, 105, 139))
	self.guardianPosition = Vector3.new(20, 4.5, 70)
	sign(m, "GUARDIAN\nEntre no círculo • Ataque [F] • saia do aviso vermelho", Vector3.new(20, 2.5, 50), Color3.fromRGB(255, 160, 177))
	local safe = part(m, "SafeRing", Vector3.new(28, 0.12, 28), Vector3.new(0, 0.3, 20), Color3.fromRGB(176, 242, 223)); safe.Transparency = 0.55; safe.CanCollide = false
	Lighting.GlobalShadows = true; Lighting.EnvironmentDiffuseScale = 0.4
	if not Lighting:FindFirstChild("ArchipelagoAir") then
		local air = Instance.new("Atmosphere"); air.Name = "ArchipelagoAir"; air.Density = .16; air.Offset = .08; air.Haze = .7; air.Glare = .12; air.Color = Color3.fromRGB(209,225,228); air.Decay = Color3.fromRGB(132,158,170); air.Parent = Lighting
		local bloom = Instance.new("BloomEffect"); bloom.Name = "CrystalBloom"; bloom.Intensity = .13; bloom.Size = 20; bloom.Threshold = 1.5; bloom.Parent = Lighting
		local sun = Instance.new("SunRaysEffect"); sun.Name = "AfternoonRays"; sun.Intensity = .04; sun.Spread = .75; sun.Parent = Lighting
	end
	-- Keep the original routes intact inside a small atomic spawn basin.
	local core = Instance.new("Model"); core.Name = "Core"; core.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	for _, item in self.model:GetChildren() do item.Parent = core end
	core.Parent = self.model; self.core = core
	core.Wilds.Transparency = 1
	self:Metadata(); Archipelago:Build(self)
	self.model:SetAttribute("WorldVersion", Definition.version)
	self.model:SetAttribute("Generated", true)
end
function World:Metadata()
	self.essenceSpawns = {}; self.areaVolumes = {}; self.areaOrder = {}
	self.guardianPosition = Vector3.new(20, 4.5, 70)
	-- Fixed spawn anchors are cheap, deterministic, and easy to move in one place.
	for i, pos in {
		Vector3.new(-5, 2.2, 18), Vector3.new(-8, 2.2, 12), Vector3.new(-7, 2.2, 4), Vector3.new(0, 2.2, -2), Vector3.new(8, 2.2, -2),
		Vector3.new(18, 2.2, -2), Vector3.new(29, 2.2, 0), Vector3.new(39, 2.2, 4), Vector3.new(49, 2.2, 8),
		Vector3.new(-20, 2.2, 25), Vector3.new(-33, 2.2, 27), Vector3.new(-48, 2.2, 25),
		Vector3.new(68, 47, 23), Vector3.new(76, 47, 36), Vector3.new(65, 47, 48),
		Vector3.new(113, 39, -60), Vector3.new(123, 39, -71), Vector3.new(-61, 2.2, -56),
	} do table.insert(self.essenceSpawns, { id = "dew_" .. i, kind = "Dew", position = pos }) end
	for i, pos in { Vector3.new(-72, 2.2, 57), Vector3.new(-57, 2.2, 65), Vector3.new(-65, 2.2, 47) } do
		table.insert(self.essenceSpawns, { id = "lumen_" .. i, kind = "Lumen", position = pos })
	end
	for id, data in Areas do
		self.areaVolumes[id] = { center = Vector3.new(table.unpack(data.center)), half = Vector3.new(table.unpack(data.size)) / 2 }
		table.insert(self.areaOrder, id)
	end
	table.sort(self.areaOrder, function(a, b) return Areas[a].priority &gt; Areas[b].priority or (Areas[a].priority == Areas[b].priority and a &lt; b) end)
	for id, position in Samples.safeSpawns or {} do if Areas[id] then Areas[id].spawn = position end end
	Archipelago:Metadata(self)
end
function World:AreaAt(position)
	for _, id in self.areaOrder do
		local v = self.areaVolumes[id]; local d = position - v.center
		if math.abs(d.X) &lt;= v.half.X and math.abs(d.Y) &lt;= v.half.Y and math.abs(d.Z) &lt;= v.half.Z then
			if Areas[id].floating then
				for _, f in Definition.floating do
					local c = Vector3.new(table.unpack(f.center)); local r = f.radius
					if math.abs(position.X-c.X)&lt;r[1]+16 and math.abs(position.Z-c.Z)&lt;r[3]+16 and math.abs(position.Y-c.Y)&lt;r[2]+20 then return id end
				end
			else return id end
		end
	end
	return nil
end
return World
</string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">StudioSmoke</string>
          <string name="Source">--!nonstrict
-- Optional read-only inspection. In Play, select Server in Command Bar:
-- require(game.ServerScriptService.Server.StudioSmoke).run()
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Config = require(ReplicatedStorage.Shared.Config)
local Smoke = {}
function Smoke.run()
	assert(RunService:IsStudio() and RunService:IsRunning(), "Run this in Studio Play, on the server")
	local world = assert(workspace:FindFirstChild("ADAPTWorld"), "Missing generated world")
	assert(world:GetAttribute("Generated"), "World generator did not finish")
	assert(world:FindFirstChild("Essence") and #world.Essence:GetChildren() &gt;= 21, "Essence spawner did not initialize")
	assert(world:FindFirstChild("Guardian") and world.Guardian:GetAttribute("MaxHealth") == Config.Guardian.MaxHealth)
	assert(world:FindFirstChild("Journey") and world:FindFirstChild("ZenithGuardian"), "Campaign objects missing")
	assert(#CollectionService:GetTagged("JourneyObject") == 40, "Expected 8 refuges, 8 shrines and 24 memories")
	for _, name in Config.Remotes do assert(ReplicatedStorage.Remotes:FindFirstChild(name), "Missing remote " .. name) end
	assert(CollectionService:HasTag(world.Core.ClimbFace, "Climbable"))
	assert(not world.Core.GripMark.CanQuery)
	assert(#CollectionService:GetTagged("NightVisionRevealable") &gt;= 8)
	local services = script.Parent.Services
	local state = require(services.PlayerService)
	assert(#Players:GetPlayers() &gt; 0, "Use Play/F5, not Run/F8")
	for _, player in Players:GetPlayers() do
		assert(state:Get(player), "Profile did not load for " .. player.Name)
		local char = assert(player.Character, "No Blank for " .. player.Name)
		assert(char:FindFirstChild("Appearance") and char:FindFirstChild("HumanoidRootPart"))
		assert(char:FindFirstChildOfClass("Humanoid").Health &gt; 0)
		assert(player.leaderstats.Evolution.Value == state:Get(player).profile.level)
		assert(state:Get(player).profile.version == 2 and state:Get(player).profile.journey.camps.Wilds)
	end
	print("[ADAPT SMOKE] Initial server invariants passed. Continue the movement, UI and multiplayer playtest.")
	return true
end
return Smoke
</string>
        </Properties>
      </Item>
      <Item class="Folder" referent="33">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Archipelago</string>
            <string name="Source">--!nonstrict
local CollectionService = game:GetService("CollectionService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Definition = require(Shared.WorldDefinition)
local Samples = require(Shared.WorldSamples)
local Archipelago = {}
local function v(a) return Vector3.new(table.unpack(a)) end
local function folder(parent,name,model)
 local f=Instance.new(model and "Model" or "Folder");f.Name=name;f.Parent=parent;return f
end
local function part(parent,name,size,cf,color,material,collide,shape)
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
 p.Anchored=true;p.CanCollide=collide==true;p.CanTouch=false;p.CanQuery=collide==true;p.CastShadow=collide==true
 p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;if shape then p.Shape=shape end;p.Parent=parent;return p
end
local function stone(parent,name,size,pos,color,collide)
 local p=part(parent,name,size,CFrame.new(pos)*CFrame.Angles(.12,.7,.15),color,Enum.Material.Rock,collide,Enum.PartType.Ball);return p
end
local function pole(parent,name,a,b,width,color,material,collide)
 return part(parent,name,Vector3.new((b-a).Magnitude,width,width),CFrame.lookAt((a+b)/2,b)*CFrame.Angles(0,math.pi/2,0),color,material,collide,Enum.PartType.Cylinder)
end
local function label(parent,name,position)
 local anchor=part(parent,"POIName",Vector3.one,CFrame.new(position),Color3.new(),nil,false);anchor.Transparency=1
 local gui=Instance.new("BillboardGui");gui.Size=UDim2.fromOffset(220,38);gui.MaxDistance=90;gui.StudsOffset=Vector3.new(0,4,0);gui.Parent=anchor
 local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.FontFace=Font.fromEnum(Enum.Font.GothamMedium);text.TextSize=14;text.TextColor3=Color3.fromRGB(245,238,219);text.TextStrokeTransparency=.45;text.Text=name;text.Parent=gui
end
local function crystal(parent,pos,height,color,hidden)
 local p=part(parent,"Crystal",Vector3.new(height*.25,height,height*.3),CFrame.new(pos+Vector3.new(0,height/2,0))*CFrame.Angles(.1,.4,.16),color,Enum.Material.Neon,false)
 if hidden then p.Transparency=1;CollectionService:AddTag(p,"NightVisionRevealable") end
 return p
end
local function tree(parent,island,data)
 local m=folder(parent,"Tree",true);m.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
 local origin=v(data.position);local s=data.scale;local tall=island.id=="Oldgrowth" and 1.55 or 1
 local wood=Color3.fromRGB(93,75,64);local leaf=Color3.fromRGB(table.unpack(island.palette));local height=17*s*tall
 if island.id=="Hollow" then
  crystal(m,origin,20*s,Color3.fromRGB(125+data.variant*20,122,198),false)
  crystal(m,origin+Vector3.new(5*s,0,2*s),9*s,Color3.fromRGB(92,171,186),false);return
 end
 pole(m,"Trunk",origin,origin+Vector3.new(1.7*s,height,0),2.5*s,wood,Enum.Material.Wood,true)
 if island.id=="Tideglass" then
  for i=1,4 do local a=i*math.pi/2+data.angle
   part(m,"PalmFrond",Vector3.new(3*s,1.2*s,14*s),CFrame.new(origin+Vector3.new(math.sin(a)*5*s,height,math.cos(a)*5*s))*CFrame.Angles(.2,a,.1),leaf,nil,false)
  end
 else
  part(m,"Canopy",Vector3.new(20,13,18)*s,CFrame.new(origin+Vector3.new(0,height,0))*CFrame.Angles(0,data.angle,0),leaf,nil,false,Enum.PartType.Ball)
  part(m,"CanopyLight",Vector3.new(13,11,14)*s,CFrame.new(origin+Vector3.new(5*s,height+5*s,-2*s)),leaf:Lerp(Color3.fromRGB(160,184,104),.18+data.variant*.07),nil,false,Enum.PartType.Ball)
 end
end
local function arch(parent,pos,width,height,color)
 for i=0,8 do
  local a=math.pi*i/8
  local point=pos+Vector3.new(math.cos(a)*width/2,math.sin(a)*height,0)
  part(parent,"ArchStone",Vector3.new(width*.22,height*.25,10),CFrame.new(point)*CFrame.Angles(0,0,a-math.pi/2),color,Enum.Material.Slate,true)
 end
end
local function climbStack(parent,pos,tiers,color,wood)
 for i=0,tiers-1 do
  local base=pos+Vector3.new(0,i*53,0)
  local wall=part(parent,"ClimbableBark",Vector3.new(14,52,3),CFrame.new(base+Vector3.new(0,26,0)),color,wood and Enum.Material.Wood or Enum.Material.Slate,true)
  CollectionService:AddTag(wall,"Climbable")
  part(parent,"RestingShelf",Vector3.new(24,3,18),CFrame.new(base+Vector3.new(0,52,4)),color,wood and Enum.Material.Wood or Enum.Material.Rock,true)
  local mark=part(parent,"GripMoss",Vector3.new(2,35,.1),CFrame.new(base+Vector3.new(0,28,-1.6)),Color3.fromRGB(213,193,108),Enum.Material.SmoothPlastic,false)
  mark.CastShadow=false
 end
end
local function waterfall(parent,pos,height,width)
 local p=part(parent,"FallingWater",Vector3.new(width,height,2),CFrame.new(pos-Vector3.new(0,height/2,0)),Color3.fromRGB(152,222,228),Enum.Material.Glass,false);p.Transparency=.28
 local foam=part(parent,"Foam",Vector3.new(width+8,1,11),CFrame.new(pos-Vector3.new(0,height,0)),Color3.fromRGB(216,244,235),Enum.Material.SmoothPlastic,false,Enum.PartType.Ball);foam.Transparency=.15
end
local function greatTree(parent,origin)
 local model=folder(parent,"TreeOfAges",true);model.ModelStreamingMode=Enum.ModelStreamingMode.Persistent
 local wood=Color3.fromRGB(87,78,67)
 pole(model,"AncientTrunk",origin,origin+Vector3.new(0,252,0),48,wood,Enum.Material.Wood,true)
 for i=1,7 do
  local a=i*math.pi*2/7;local radial=Vector3.new(math.cos(a),0,math.sin(a))
  pole(model,"ButtressRoot",origin+radial*90,origin+radial*9+Vector3.new(0,65,0),20,wood,Enum.Material.Wood,true)
  pole(model,"CrownBranch",origin+Vector3.new(0,185,0),origin+radial*86+Vector3.new(0,245+i%3*16,0),13,wood,Enum.Material.Wood,true)
  part(model,"HighCanopy",Vector3.new(118,60,105),CFrame.new(origin+radial*70+Vector3.new(0,260+i%3*17,0)),Color3.fromRGB(48+i*3,105+i*4,86),nil,false,Enum.PartType.Ball)
 end
 climbStack(model,origin+Vector3.new(0,0,-26),4,wood,true)
 return model
end
local function poi(parent,data)
 local m=folder(parent,data.id,true);m:SetAttribute("POI",true);m:SetAttribute("DisplayName",data.name);m:SetAttribute("Region",data.island)
 local pos=v(data.position);local dark=Color3.fromRGB(100,103,113);local kind=data.kind
 if kind=="Arch" then arch(m,pos,40,35,data.island=="Sunscar" and Color3.fromRGB(188,132,85) or dark)
 elseif kind=="GreatTree" then greatTree(m,pos)
 elseif kind=="Waterfall" then
  stone(m,"SourceOutcrop",Vector3.new(30,15,35),pos,dark,true);waterfall(m,pos+Vector3.new(17,6,0),math.max(45,math.min(pos.Y+18,125)),14)
 elseif kind=="Climb" then
  stone(m,"Pillar",Vector3.new(30,150,32),pos+Vector3.new(0,65,17),dark,true);climbStack(m,pos,3,dark,false)
 elseif kind=="Ruins" then
  for i=1,5 do local a=i*math.pi*2/5
   part(m,"WeatheredColumn",Vector3.new(5,10+i%3*5,5),CFrame.new(pos+Vector3.new(math.cos(a)*15,5,math.sin(a)*15))*CFrame.Angles(0,a,.08*i),Color3.fromRGB(149,155,132),Enum.Material.Limestone,true)
  end
 elseif kind=="Mystery" then
  m.ModelStreamingMode=Enum.ModelStreamingMode.Persistent
  for i=1,12 do local a=i*math.pi/6
   local p=part(m,"SuspendedMonolith",Vector3.new(5,20,7),CFrame.new(pos+Vector3.new(math.cos(a)*34,22+math.sin(a*2)*8,math.sin(a)*34))*CFrame.Angles(.15,a,.3),Color3.fromRGB(119,115,162),Enum.Material.Slate,true)
   crystal(m,p.CFrame.Position+Vector3.new(0,10,0),3,Color3.fromRGB(132,230,223),false)
  end
 elseif kind=="Crystals" then
  m.ModelStreamingMode=Enum.ModelStreamingMode.Persistent
  for i=1,7 do local a=i*math.pi*2/7;crystal(m,pos+Vector3.new(math.cos(a)*20,0,math.sin(a)*20),35+i%3*21,Color3.fromRGB(149,146,225),false) end
 elseif kind=="Secret" then
  for i=1,3 do crystal(m,pos+Vector3.new(i*3,0,2),7+i,Color3.fromRGB(151,226,200),true) end
 elseif kind=="Vents" then
  for i=1,5 do
   local vent=stone(m,"Vent",Vector3.new(10,6,10),pos+Vector3.new(i*9-27,1,i%2*17),Color3.fromRGB(59,54,60),true)
   local smoke=Instance.new("ParticleEmitter");smoke.Name="VolcanicHaze";smoke.Texture="rbxasset://textures/particles/smoke_main.dds";smoke.Rate=2;smoke.Lifetime=NumberRange.new(4,7);smoke.Speed=NumberRange.new(4,7);smoke.Color=ColorSequence.new(Color3.fromRGB(117,108,112));smoke.Size=NumberSequence.new(5);smoke.Transparency=NumberSequence.new(.65);smoke.Parent=vent;CollectionService:AddTag(smoke,"AmbientEmitter")
  end
 elseif kind=="Underwater" or kind=="Coral" then
  for i=1,6 do crystal(m,pos+Vector3.new(i*5-18,0,math.sin(i)*10),7+i%3*4,Color3.fromRGB(132+i*12,148,167+i*9),false) end
 elseif kind=="Cave" then
  -- The opening is real carved Terrain; these rocks frame it without closing it.
  stone(m,"MouthLeft",Vector3.new(9,19,13),pos+Vector3.new(-22,7,0),dark,false)
  stone(m,"MouthRight",Vector3.new(10,17,12),pos+Vector3.new(22,6,0),dark,false)
 elseif kind=="Vista" then
  stone(m,"ViewStone",Vector3.new(7,12,5),pos+Vector3.new(12,4,8),dark,true)
 elseif kind=="Salt" then
  part(m,"SaltPan",Vector3.new(55,.25,43),CFrame.new(pos+Vector3.new(0,.2,0)),Color3.fromRGB(225,210,185),Enum.Material.Salt,false)
 end
 if kind~="Secret" then label(m,data.name,pos+Vector3.new(0,5,0)) end
 return m
end
function Archipelago:Metadata(world)
 for _, p in Samples.pois do
  local position=v(p.position)+Vector3.new(0,2.3,0);local kind="Dew"
  if p.kind=="Secret" then kind="Lumen" end
  if p.kind=="Cave" then
   for _, c in Samples.caves do if c.id==p.id then local endPoint=v(c.points[#c.points]);position=endPoint-Vector3.new(0,c.radius-3,0);kind="Lumen" end end
  end
  table.insert(world.essenceSpawns,{id="poi_"..p.id,kind=kind,position=position})
 end
 for _, route in Samples.routes do
  for i=4,#route.points,5 do table.insert(world.essenceSpawns,{id=route.id.."_"..i,kind="Dew",position=v(route.points[i])+Vector3.new(0,2.4,0)}) end
 end
 for _, item in Samples.islets or {} do table.insert(world.essenceSpawns,{id=item.id,kind="Dew",position=v(item.position)+Vector3.new(0,2.3,0)}) end
 for _, f in Definition.floating do
  if f.id~="LumenPerch" then table.insert(world.essenceSpawns,{id="sky_"..f.id,kind="Dew",position=v(f.center)+Vector3.new(0,f.radius[2]+2.2,0)}) end
 end
end
function Archipelago:Build(world)
 local root=world.model
 local islands=folder(root,"Islands");local vegetation=folder(root,"Vegetation");local landmarks=folder(root,"Landmarks");local pois=folder(root,"POIs");local environment=folder(root,"Environment");local paths=folder(root,"SeaPaths");local reservations=folder(root,"FutureRoutes")
 for index,island in Definition.islands do
  local region=folder(islands,island.id,true);region:SetAttribute("DisplayName",island.name);region:SetAttribute("Region",island.area)
  local growth=folder(vegetation,island.id)
  for _, t in Samples.islands[index].trees do tree(growth,island,t) end
  for _, rock in Samples.islands[index].rocks do local p=stone(region,"CoastalBoulder",Vector3.new(1.7,1,1.4)*rock.scale,v(rock.position),Color3.fromRGB(105,110,115),false);p.CFrame*=CFrame.Angles(0,rock.angle,.2) end
 end
 for _, data in Samples.pois do poi(pois,data) end
 for _, cave in Samples.caves do
  if cave.approach then
   local a=v(cave.approach[1])-Vector3.new(0,12.5,0);local b=v(cave.approach[2])-Vector3.new(0,12.5,0)
   local ramp=part(pois:FindFirstChild(cave.id) or environment,"CaveEntryShelf",Vector3.new(15,1.4,(b-a).Magnitude+4),CFrame.lookAt((a+b)/2,b),Color3.fromRGB(113,126,118),Enum.Material.Rock,true)
   ramp:SetAttribute("CaveExit",cave.id)
  end
 end
 for _, route in Samples.routes do
  local trail=folder(paths,route.id,true);trail:SetAttribute("WalkableConnection",true)
  for i=2,#route.points,5 do
   local pos=v(route.points[i]);stone(trail,"TideRock",Vector3.new(9,11,8),pos+Vector3.new(18,3,9),Color3.fromRGB(118,137,132),false)
   stone(trail,"TrailPebbles",Vector3.new(4,1,5),pos+Vector3.new(0,.5,0),Color3.fromRGB(215,205,168),false)
  end
 end
 for _, bridge in Samples.bridges or {} do
  local model=paths:FindFirstChild(bridge.id);local a=v(bridge.ends[1]);local b=v(bridge.ends[2])
  for i=0,6 do
   local t=i/6;local center=a:Lerp(b,t)+Vector3.new(0,math.sin(t*math.pi)*3-1.5,0)
   part(model,"NaturalBridgeDeck",Vector3.new(21,3,7.1),CFrame.lookAt(center,center+(b-a)),Color3.fromRGB(145,151,137),Enum.Material.Limestone,true)
  end
  for _, point in {a,b} do
   stone(model,"BridgeAbutment",Vector3.new(25,8,21),point-Vector3.new(0,4,0),Color3.fromRGB(112,132,127),false)
  end
 end
local outer=folder(islands,"OuterShoals",true)
 for i,item in Samples.islets or {} do
  local model=folder(outer,item.id,true);local pos=v(item.position)
  stone(model,"SeaStack",Vector3.new(9,14+i%4*4,8),pos+Vector3.new(8,4,8),Color3.fromRGB(111,135,139),false)
  crystal(model,pos+Vector3.new(-9,0,-5),5+i%3,Color3.fromRGB(149,201,185),false)
 end
 local sky=folder(islands,"SkyReach",true)
 for i,f in Definition.floating do
  local model=folder(sky,f.id,true);label(model,f.id,v(f.center)+Vector3.new(0,f.radius[2]+5,0))
  if f.id~="LumenPerch" then
   for j=1,3 do crystal(model,v(f.center)+Vector3.new(j*8-14,f.radius[2]-.6,0),6+j*2,Color3.fromRGB(145,192,217),false) end
   for j=1,3 do
    local dx=(j-2)*f.radius[1]*.25;local dz=(j%2)*f.radius[3]*.22
    local y=f.center[2]+f.radius[2]*math.sqrt(1-(dx/f.radius[1])^2-(dz/f.radius[3])^2)
    tree(model,{id="Sky",palette={151,174,198}},{position={f.center[1]+dx,y,f.center[3]+dz},scale=.7,angle=j,variant=j%3})
   end
   if i%2==0 then waterfall(model,v(f.center)+Vector3.new(f.radius[1]*.65,f.radius[2]*.7,0),f.radius[2]*3+20,7) end
  end
 end
 local volcano=folder(landmarks,"EmberCaldera",true);volcano.ModelStreamingMode=Enum.ModelStreamingMode.Persistent
 local lava=part(volcano,"CalderaLava",Vector3.new(1,83,83),CFrame.new(1100,313,-1020)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(255,122,53),Enum.Material.Neon,false,Enum.PartType.Cylinder)
 lava:SetAttribute("FutureRequirement","HeatResistance")
 for i=1,9 do local a=i*math.pi*2/9;stone(volcano,"InnerBasaltSteps",Vector3.new(13,5,12),Vector3.new(1100+math.cos(a)*48,317+i%3*3,-1020+math.sin(a)*48),Color3.fromRGB(75,62,64),true) end
 -- A few distant silhouettes are persistent, while all dense decoration streams normally.
 for _, f in Definition.floating do
  if f.id=="ZenithCrown" or f.id=="StarNeedle" then
   local beacon=folder(landmarks,f.id.."Silhouette",true);beacon.ModelStreamingMode=Enum.ModelStreamingMode.Persistent
   crystal(beacon,v(f.center)+Vector3.new(0,f.radius[2],0),28,Color3.fromRGB(167,198,225),false)
  end
 end
 for _, reservation in Definition.reservations do
  local marker=part(reservations,reservation.id,Vector3.one,CFrame.new(v(reservation.position)),Color3.new(),nil,false);marker.Transparency=1;marker:SetAttribute("FutureAdaptation",reservation.ability)
 end
 root:SetAttribute("POICount",#Samples.pois);root:SetAttribute("WorldWidth",Definition.extent*2)
 return environment
end
return Archipelago
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Sanctuaries</string>
            <string name="Source">--!nonstrict
local Shared = game:GetService("ReplicatedStorage").Shared
local Journey = require(Shared.Journey)
local Locations = require(Shared.JourneyLocations)
local CollectionService = game:GetService("CollectionService")
local Sanctuaries = {}
local function part(parent, name, size, pos, color, material, collide)
	local p = Instance.new("Part"); p.Name = name; p.Size = size; p.CFrame = CFrame.new(pos); p.Color = color
	p.Anchored = true; p.CanCollide = collide == true; p.CanQuery = collide == true; p.CanTouch = false
	p.Material = material or Enum.Material.Slate; p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth; p.Parent = parent; return p
end
local function label(partObject, text, color)
	local gui = Instance.new("BillboardGui"); gui.Size = UDim2.fromOffset(230, 58); gui.StudsOffset = Vector3.new(0, 5, 0); gui.MaxDistance = 100; gui.Parent = partObject
	local t = Instance.new("TextLabel"); t.Size = UDim2.fromScale(1, 1); t.BackgroundTransparency = 1; t.Text = text; t.TextWrapped = true; t.FontFace = Font.fromEnum(Enum.Font.GothamBold); t.TextSize = 15; t.TextColor3 = color; t.TextStrokeTransparency = .4; t.Parent = gui
end
local function prompt(partObject, action, target)
	local p = Instance.new("ProximityPrompt"); p.Name = "Interact"; p.ActionText = action; p.ObjectText = target; p.KeyboardKeyCode = Enum.KeyCode.R; p.GamepadKeyCode = Enum.KeyCode.ButtonB; p.HoldDuration = .35; p.MaxActivationDistance = 12; p.RequiresLineOfSight = false; p.Parent = partObject
end
function Sanctuaries:Build(world)
	local old = world.model:FindFirstChild("Journey")
	if old and old:GetAttribute("Version") == Journey.version then return old end
	if old then old:Destroy() end
	local folder = Instance.new("Folder"); folder.Name = "Journey"; folder.Parent = world.model; folder:SetAttribute("Version", Journey.version)
	for _, area in Journey.order do
		local region = Journey.regions[area]; local color = Color3.fromRGB(table.unpack(region.color)); local pos = Vector3.new(table.unpack(Locations.camps[area]))
		local vegetation = world.model:FindFirstChild("Vegetation")
		if vegetation then
			for _, tree in vegetation:GetDescendants() do
				local trunk = tree:IsA("Model") and tree:FindFirstChild("Trunk")
				if trunk and Vector3.new(trunk.CFrame.Position.X-pos.X,0,trunk.CFrame.Position.Z-pos.Z).Magnitude &lt; 19 then tree:Destroy() end
			end
		end
		local m = Instance.new("Model"); m.Name = area; m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic; m.Parent = folder
		local floorY = pos.Y - 4
		part(m, "SanctuaryFloor", Vector3.new(26, 1, 22), Vector3.new(pos.X, floorY, pos.Z), Color3.fromRGB(100, 124, 124), Enum.Material.Slate, true)
		-- Four shallow steps let the original terrain meet each raised refuge.
		for i = 1, 4 do part(m, "EntryStep", Vector3.new(14, 1, 3.5), Vector3.new(pos.X, floorY - i * .65, pos.Z + 10 + i * 2.8), Color3.fromRGB(122, 147, 139), Enum.Material.Slate, true) end
		local camp = part(m, "Camp", Vector3.new(2, 3, 2), pos + Vector3.new(-7, -1.5, 0), color, Enum.Material.Neon, false)
		camp.Shape = Enum.PartType.Ball; camp:SetAttribute("Camp", area); prompt(camp, "Descansar", "Refúgio • " .. region.name)
		CollectionService:AddTag(camp, "JourneyObject")
		label(camp, "REFÚGIO\nCura • troca de corpo • viagem", color)
		local shrine = part(m, "Shrine", Vector3.new(3, 5, 3), pos + Vector3.new(7, -.5, 0), color, Enum.Material.Neon, false)
		shrine.CFrame *= CFrame.Angles(0, math.pi/4, .15); shrine:SetAttribute("Shrine", area); prompt(shrine, "Restaurar", region.name)
		CollectionService:AddTag(shrine, "JourneyObject")
		for side = -1, 1, 2 do part(m, "ShrinePillar", Vector3.new(2, 8, 2), pos + Vector3.new(7 + side * 4, 0, 0), Color3.fromRGB(78, 88, 108), Enum.Material.Slate, true) end
		part(m, "ShrineLintel", Vector3.new(12, 2, 3), pos + Vector3.new(7, 4, 0), color, Enum.Material.Slate, true)
		local light = Instance.new("PointLight"); light.Color = color; light.Range = 16; light.Brightness = .6; light.Parent = camp
	end
	for id, data in Locations.runes do
		local color = Color3.fromRGB(table.unpack(Journey.regions[data.region].color)); local pos = Vector3.new(table.unpack(data.position))
		local m = Instance.new("Model"); m.Name = id; m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic; m.Parent = folder
		local rune = part(m, "Memory", Vector3.new(1.8, 3, 1.8), pos, color, Enum.Material.Neon, false); rune.CFrame *= CFrame.Angles(0, math.pi/4, .12)
		rune:SetAttribute("Memory", id); rune:SetAttribute("Region", data.region); prompt(rune, "Lembrar", "Memória • " .. Journey.regions[data.region].name)
		CollectionService:AddTag(rune, "JourneyObject")
		label(rune, "MEMÓRIA", color)
	end
	local arena = Instance.new("Model"); arena.Name = "ZenithArena"; arena.ModelStreamingMode = Enum.ModelStreamingMode.Atomic; arena.Parent = folder
	local center = Vector3.new(table.unpack(Journey.finale.position))
	local floor = part(arena, "ArenaFloor", Vector3.new(78, 2, 78), center - Vector3.new(0, 5, 0), Color3.fromRGB(92, 100, 135), Enum.Material.Slate, true)
	floor.Shape = Enum.PartType.Cylinder; floor.Size = Vector3.new(2, 78, 78); floor.CFrame *= CFrame.Angles(0, 0, math.pi/2)
	for i = 1, 12 do
		local a = math.pi * 2 * i / 12
		part(arena, "RimGlyph", Vector3.new(3, .2, 4), center + Vector3.new(math.cos(a)*35, -3.8, math.sin(a)*35), Color3.fromRGB(200, 180, 255), Enum.Material.Neon, false)
	end
	return folder
end
return Sanctuaries
</string>
